Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"expMeanData", "=", 
     RowBox[{"extractXYME", "[", "plotOverallMeanExp", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"expSDData", "=", 
