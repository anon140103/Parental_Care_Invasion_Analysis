      RowBox[{"{", 
       RowBox[{"xs", "=", 
        RowBox[{"zeroCrossingsXNotOriginAll", "[", 
         RowBox[{"data", ",", "tol"}], "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "xs", "]"}], "<", "2"}], ",", 
        RowBox[{"Missing", "[", "\"\<NoSecondZeroCrossing\>\"", "]"}], ",", 
        RowBox[{"xs", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
