Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getLineData", "[", "g_", "]"}], ":=", 
    RowBox[{"First", "@", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "g", "]"}], ",", 
       RowBox[{
        RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}], 
      "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"maxPointFromData", "[", "data_", "]"}], ":=", 
    RowBox[{"First", "@", 
     RowBox[{"MaximalBy", "[", 
      RowBox[{"data", ",", "Last"}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"zeroCrossingsXNotOriginAll", "[", 
     RowBox[{"data_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pts", "=", 
         RowBox[{"SortBy", "[", 
          RowBox[{"data", ",", "First"}], "]"}]}], ",", "segs", ",", 
        "roots"}], "}"}], ",", 
      RowBox[{
       RowBox[{"segs", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{"pts", ",", "2", ",", "1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"roots", "=", 
        RowBox[{
         RowBox[{"Reap", "[", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x1", "=", 
                 RowBox[{"seg", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"y1", "=", 
                 RowBox[{"seg", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
                RowBox[{"x2", "=", 
                 RowBox[{"seg", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{"y2", "=", 
                 RowBox[{"seg", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "y1", "]"}], "<=", "tol"}], "&&", 
                  RowBox[{
                   RowBox[{"Abs", "[", "x1", "]"}], ">", "tol"}]}], ",", 
                 RowBox[{"Sow", "[", "x1", "]"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "y2", "]"}], "<=", "tol"}], "&&", 
                  RowBox[{
                   RowBox[{"Abs", "[", "x2", "]"}], ">", "tol"}]}], ",", 
                 RowBox[{"Sow", "[", "x2", "]"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"y1", "*", "y2"}], "<", "0"}], ",", 
                 RowBox[{"With", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"x0", "=", 
                    RowBox[{"x1", "-", 
                    RowBox[{"y1", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"x2", "-", "x1"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"y2", "-", "y1"}], ")"}]}]}]}]}], "}"}], ",", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "x0", "]"}], ">", "tol"}], ",", 
                    RowBox[{"Sow", "[", "x0", "]"}]}], "]"}]}], "]"}]}], 
                "]"}], ";"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"seg", ",", "segs"}], "}"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"roots", "===", 
           RowBox[{"{", "}"}]}], "||", 
          RowBox[{"roots", "===", 
           RowBox[{"{", 
            RowBox[{"{", "}"}], "}"}]}]}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{
          RowBox[{"roots", "=", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{
             RowBox[{"First", "@", "roots"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#1", "-", "#2"}], "]"}], "<", 
               RowBox[{"10", "^", 
                RowBox[{"-", "6"}]}]}], "&"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Sort", "@", 
           RowBox[{"Select", "[", 
            RowBox[{"roots", ",", 
             RowBox[{
              RowBox[{"#", ">", "tol"}], "&"}]}], "]"}]}]}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"firstZeroCrossingXNotOrigin", "[", 
     RowBox[{"data_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xs", "=", 
        RowBox[{"zeroCrossingsXNotOriginAll", "[", 
         RowBox[{"data", ",", "tol"}], "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"xs", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Missing", "[", "\"\<NoPositiveZeroCrossing\>\"", "]"}], ",", 
        
        RowBox[{"xs", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"secondZeroCrossingXNotOrigin", "[", 
     RowBox[{"data_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
