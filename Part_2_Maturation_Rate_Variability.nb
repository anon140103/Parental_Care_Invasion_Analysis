Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"makeMeanSDOverlayDashedME", "[", 
    RowBox[{"meanG_", ",", "sdG_", ",", "title_", ",", "panelLabel_"}], "]"}],
    ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "meanData", ",", "sdData", ",", "xMin", ",", "xMax", ",", "meanMin", ",",
        "meanMax", ",", "sdMin", ",", "sdMax", ",", "meanPad", ",", "sdPad", ",",
        "meanPR", ",", "sdPR", ",", "scale", ",", "meanPlot", ",", 
       "sdScaledPlot", ",", "sdTickVals", ",", "sdTickPos", ",", 
       "sdTicksRight", ",", "epilogContent"}], "}"}], ",", 
     RowBox[{
      RowBox[{"meanData", "=", 
       RowBox[{"extractXYME", "[", "meanG", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sdData", "=", 
       RowBox[{"extractXYME", "[", "sdG", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xMin", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"meanData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xMax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"meanData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"meanMin", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"meanData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"meanMax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"meanData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sdMin", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"sdData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sdMax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"sdData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"meanPad", "=", 
       RowBox[{"0.05", "*", 
        RowBox[{"(", 
         RowBox[{"meanMax", "-", "meanMin"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"meanPad", "==", "0"}], ",", 
        RowBox[{"meanPad", "=", "0.1"}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"sdPad", "=", 
       RowBox[{"0.05", "*", 
        RowBox[{"(", 
         RowBox[{"sdMax", "-", "sdMin"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sdPad", "==", "0"}], ",", 
        RowBox[{"sdPad", "=", "0.1"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"meanPR", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"meanMin", "-", "meanPad"}], ",", 
         RowBox[{"meanMax", "+", "meanPad"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sdPR", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"sdMax", "+", "sdPad"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"scale", "[", "y_", "]"}], ":=", 
       RowBox[{"Rescale", "[", 
        RowBox[{"y", ",", "sdPR", ",", "meanPR"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"meanPlot", "=", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"meanData", ",", 
         RowBox[{"Joined", "->", "True"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Orange", ",", "Thick", ",", "Dashed", ",", 
            RowBox[{"Opacity", "[", "0.45", "]"}]}], "]"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"xMin", ",", "xMax"}], "}"}], ",", "meanPR"}], "}"}]}]}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sdScaledPlot", "=", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"scale", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
           "sdData"}], ")"}], ",", 
         RowBox[{"Joined", "->", "True"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"RGBColor", "[", 
             RowBox[{"0", ",", "0.35", ",", "0"}], "]"}], ",", "Thick"}], 
           "]"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"xMin", ",", "xMax"}], "}"}], ",", "meanPR"}], "}"}]}]}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sdTickVals", "=", 
       RowBox[{"N", "@", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"sdPR", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"sdPR", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "5"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sdTickPos", "=", 
       RowBox[{"scale", "/@", "sdTickVals"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sdTicksRight", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"#2", ",", 
              RowBox[{"{", 
               RowBox[{"Infinity", ",", "3"}], "}"}]}], "]"}]}], "}"}], "&"}],
          ",", 
         RowBox[{"{", 
          RowBox[{"sdTickPos", ",", "sdTickVals"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"epilogContent", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"panelLabel", "===", "\"\<\>\""}], "||", 
          RowBox[{"panelLabel", "===", "None"}]}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Inset", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\<(\>\"", "<>", "panelLabel", "<>", "\"\<)\>\""}], ",",
               "14", ",", "Bold"}], "]"}], ",", 
            RowBox[{"Scaled", "[", 
             RowBox[{"{", 
              RowBox[{"0.5", ",", "0.95"}], "}"}], "]"}]}], "]"}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{"meanPlot", ",", "sdScaledPlot", ",", 
        RowBox[{"ImageSize", "->", 
         RowBox[{"{", 
          RowBox[{"imgW", ",", "imgH"}], "}"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"Axes", "->", "False"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Mean \[Lambda]\>\"", ",", "18"}], "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<SD(\[Lambda])\>\"", ",", "18"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<c\>\"", ",", "20"}], "]"}], ",", "None"}], "}"}]}],
           "}"}]}], ",", 
        RowBox[{"LabelStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", "16"}], "]"}]}], ",", 
        RowBox[{"FrameTicks", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Automatic", ",", "sdTicksRight"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Automatic", ",", "None"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", "None"}], ",", 
        RowBox[{"Epilog", "->", 
         RowBox[{"Join", "[", 
          RowBox[{"epilogContent", ",", 
           RowBox[{"{", 
            RowBox[{"Inset", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{"\"\<SD(\[Lambda]*): 8.91%\>\"", ",", 
                   RowBox[{"Spacer", "[", "35", "]"}], ",", "\"\<|\>\"", ",", 
                   
                   RowBox[{"Spacer", "[", "25", "]"}], 
                   ",", "\"\<\[CapitalDelta](c*-cSD): N/A\>\""}], "}"}], 
                 "]"}], ",", "16"}], "]"}], ",", 
              RowBox[{"Scaled", "[", 
               RowBox[{"{", 
                RowBox[{"0.45", ",", "0.06"}], "}"}], "]"}]}], "]"}], "}"}]}],
           "]"}]}]}], "]"}]}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
