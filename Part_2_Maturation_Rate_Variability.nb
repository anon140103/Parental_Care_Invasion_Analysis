 RowBox[{
  RowBox[{
   RowBox[{"resultsME", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Exponential\>\"", ",", "\"\<Deterministic\>\"", ",", 
        RowBox[{"maxPointFromData", "[", "detExpDataME", "]"}], ",", 
        RowBox[{"firstZeroCrossingXNotOrigin", "[", "detExpDataME", "]"}], ",", 
        RowBox[{"secondZeroCrossingXNotOrigin", "[", "detExpDataME", "]"}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Exponential\>\"", ",", "\"\<Stochastic\>\"", ",", 
