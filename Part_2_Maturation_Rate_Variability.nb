Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getLineData", "[", "g_", "]"}], ":=", 
   RowBox[{"First", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "g", "]"}], ",", 
      RowBox[{
       RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getPlotColour", "[", "g_", "]"}], ":=", 
    RowBox[{"First", "@", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "g", "]"}], ",", "_RGBColor", ",", "Infinity"}],
       "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ValueQ", "[", "meanYRange", "]"}], "&&", 
      RowBox[{"MatchQ", "[", 
       RowBox[{"meanYRange", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"_", "?", "NumericQ"}], ",", 
          RowBox[{"_", "?", "NumericQ"}]}], "}"}]}], "]"}]}], ",", "Null", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"And", "[", 
        RowBox[{
         RowBox[{"ValueQ", "[", "overallMeanRExp", "]"}], ",", 
         RowBox[{"ValueQ", "[", "fit1", "]"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"allMeanDetValues", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"overallMeanRExp", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"fit1", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minMeanY", "=", 
         RowBox[{"Min", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxMeanY", "=", 
         RowBox[{"Max", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rangeMean", "=", 
         RowBox[{"maxMeanY", "-", "minMeanY"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"paddingMean", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"rangeMean", "==", "0"}], ",", "0.1", ",", 
           RowBox[{"0.05", "*", "rangeMean"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"meanYRange", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"minMeanY", "-", "paddingMean"}], ",", 
           RowBox[{"maxMeanY", "+", "paddingMean"}]}], "}"}]}]}], ",", 
       RowBox[{
        RowBox[{"allMeanDetValues", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"getLineData", "[", "plotExp", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"getLineData", "[", "plotOverallMeanExp", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minMeanY", "=", 
         RowBox[{"Min", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxMeanY", "=", 
         RowBox[{"Max", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rangeMean", "=", 
         RowBox[{"maxMeanY", "-", "minMeanY"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"paddingMean", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"rangeMean", "==", "0"}], ",", "0.1", ",", 
           RowBox[{"0.05", "*", "rangeMean"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"meanYRange", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"minMeanY", "-", "paddingMean"}], ",", 
           RowBox[{"maxMeanY", "+", "paddingMean"}]}], "}"}]}]}]}], "]"}]}], 
    "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"detData", "=", 
   RowBox[{"getLineData", "[", "plotExp", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stochData", "=", 
    RowBox[{"getLineData", "[", "plotOverallMeanExp", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"detCol", "=", 
   RowBox[{"getPlotColour", "[", "plotExp", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stochCol", "=", 
    RowBox[{"getPlotColour", "[", "plotOverallMeanExp", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exponentialOneEntityME", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"detData", ",", "stochData"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"detCol", ",", "Thick"}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"stochCol", ",", "Thick"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}], ",", "meanYRange"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<c\>\"", ",", "18"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<\[Lambda]\>\"", ",", "18"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "14", ",", 
         RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], "]"}]}], ",", 
      RowBox[{"ImageSize", "->", "500"}], ",", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<\[CapitalDelta](c*) = 0.0000\>\"", ",", 
               RowBox[{"Spacer", "[", "25", "]"}], ",", "\"\<|\>\"", ",", 
               RowBox[{"Spacer", "[", "25", "]"}], 
               ",", "\"\<\[CapitalDelta](\[Lambda]*) = 0.0000\>\"", ",", 
               RowBox[{"Spacer", "[", "25", "]"}], ",", "\"\<|\>\"", ",", 
               RowBox[{"Spacer", "[", "25", "]"}], 
               ",", "\"\<\[CapitalDelta](c\:2080) = -0.0059\>\""}], "}"}], 
             "]"}], ",", "20", ",", 
            RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], "]"}], 
          ",", 
          RowBox[{"Scaled", "[", 
