 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"diffRowForShape", "[", "shape_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"det", ",", "stoch"}], "}"}], ",", 
      RowBox[{
       RowBox[{"det", "=", 
        RowBox[{"SelectFirst", "[", 
         RowBox[{"resultsME", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "shape"}], "&&", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], 
             "==", "\"\<Deterministic\>\""}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"stoch", "=", 
        RowBox[{"SelectFirst", "[", 
         RowBox[{"resultsME", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "shape"}], "&&", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "==", "\"\<Stochastic\>\""}]}], 
           "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"shape", ",", "\"\<Stoch-Det\>\"", ",", 
         RowBox[{
          RowBox[{"stoch", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "-", 
          RowBox[{"det", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"stoch", "[", 
