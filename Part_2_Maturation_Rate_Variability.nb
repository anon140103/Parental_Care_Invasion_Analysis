Cell[BoxData[{
 RowBox[{
  RowBox[{"imgW", "=", "520"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"imgH", "=", "300"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"meanStyleDashedME", "=", 
   RowBox[{"Directive", "[", 
    RowBox[{"Orange", ",", "Thick", ",", "Dashed", ",", 
     RowBox[{"Opacity", "[", "0.45", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sdStyleDarkME", "=", 
    RowBox[{"Directive", "[", 
