         "*)"}], "\[IndentingNewLine]", "paramSets", ",", 
        RowBox[{"(*", 
         RowBox[{
         "parameter", " ", "sets", " ", "with", " ", "different", " ", 
          "maturation", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
        "fitnessFixedC", ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "fitness", " ", "values", " ", "at", " ", "fixed", " ", "care", " ",
            "c"}], "=", "0.5"}], "*)"}], "\[IndentingNewLine]", 
        "resultsFixedC", ",", 
        RowBox[{"(*", 
         RowBox[{"paired", " ", 
          RowBox[{"(", 
           RowBox[{"maturation", " ", "x", " ", "fitness"}], ")"}], " ", 
          "values"}], "*)"}], "\[IndentingNewLine]", "fitnessByCare", ",", 
        RowBox[{"(*", 
         RowBox[{
         "fitness", " ", "values", " ", "across", " ", "all", " ", "care", " ",
           "levels"}], "*)"}], "\[IndentingNewLine]", "meanByCare", ",", 
        RowBox[{"(*", 
         RowBox[{"mean", " ", "fitness", " ", "across", " ", "care"}], "*)"}],
         "\[IndentingNewLine]", "sdByCare"}], "          ", 
       RowBox[{"(*", 
        RowBox[{
        "standard", " ", "deviation", " ", "of", " ", "fitness", " ", 
         "across", " ", "care"}], "*)"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"fix", " ", "seed"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"draw", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"mEVals", "=", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"maturationRateDist", "[", 
           RowBox[{"meanME", ",", "kappa"}], "]"}], ",", "n"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "plot", " ", "sampled", " ", "maturation", " ", "rate", " ", 
         "distribution"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"Histogram", "[", 
         RowBox[{"mEVals", ",", "20", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Maturation rate (mE)\>\"", 
             ",", "\"\<Frequency\>\""}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Maturation rate distribution (\>\"", "<>", "shape", 
            "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "build", " ", "parameter", " ", "sets", " ", "by", " ", "replacing", " ",
          "maturation", " ", "rate"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"paramSets", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"baseParamsMaturation", ",", 
            RowBox[{"{", 
             RowBox[{"mE", "->", "me"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"me", ",", "mEVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "invasion", " ", "fitness", " ", "at", " ", "fixed", " ", "care", " ",
           "c"}], "=", "0.5"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitnessFixedC", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"getFitFixedC", "[", 
           RowBox[{
            RowBox[{"paramSets", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "shape"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "pair", " ", "maturation", " ", "value", " ", "with", " ", 
         "fitness"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"resultsFixedC", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"mEVals", ",", "fitnessFixedC"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "plot", " ", "fitness", " ", "vs", " ", "maturation", " ", "rate", " ",
           "at", " ", "c"}], "=", "0.5"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"resultsFixedC", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Maturation rate (mE)\>\"", 
             ",", "\"\<Fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Fitness vs maturation rate (\>\"", "<>", "shape", 
            "<>", "\"\<, c = 0.5, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "invasion", " ", "fitness", " ", "across", " ", "full", " ", "care", " ",
          "range"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitnessByCare", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"getFitAtC", "[", 
               RowBox[{
                RowBox[{"paramSets", "[", 
