            RowBox[{"0.5", ",", "0.06"}], "}"}], "]"}]}], "]"}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{"detCol", ",", "Thick"}], "]"}], ",", 
           RowBox[{"Directive", "[", 
            RowBox[{"stochCol", ",", "Thick"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Deterministic\>\"", ",", "\"\<Stochastic\>\""}], "}"}],
          ",", 
         RowBox[{"LegendLayout", "->", "\"\<Row\>\""}], ",", 
         RowBox[{"LabelStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"20", ",", 
            RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
           "]"}]}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", "exponentialOneEntityME"}], "Input",
