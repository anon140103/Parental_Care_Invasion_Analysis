        RowBox[{"firstZeroCrossingXNotOrigin", "[", "stochExpDataME", "]"}], ",", 
        RowBox[{
        "secondZeroCrossingXNotOrigin", "[", "stochExpDataME", "]"}]}], "}"}],
       ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Saturating\>\"", ",", "\"\<Deterministic\>\"", ",", 
        RowBox[{"maxPointFromData", "[", "detSatDataME", "]"}], ",", 
