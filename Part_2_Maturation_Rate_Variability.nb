    RowBox[{
    "Get", " ", "max", " ", "eigenvalue", " ", "and", " ", "care", " ", 
     "level", " ", "at", " ", "max", " ", "eigenvalue"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"expMaxPoint", "=", 
     RowBox[{"First", "@", 
      RowBox[{"MaximalBy", "[", 
       RowBox[{"expMeanData", ",", "Last"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cStarExp", "=", 
     RowBox[{"expMaxPoint", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lambdaMaxExp", "=", 
     RowBox[{"expMaxPoint", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Get", " ", "SD", " ", "at", " ", "this", " ", "care", " ", "level"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"expSDPointAtCStar", "=", 
     RowBox[{"First", "@", 
      RowBox[{"Nearest", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"expSDData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "->", "expSDData"}], ",", 
        "cStarExp"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sdAtCStarExp", "=", 
     RowBox[{"expSDPointAtCStar", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Do", " ", "SD", " ", "as", " ", "a", " ", "%", " ", "of", " ", "the", " ",
      "max", " ", "eigenvalue"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sdPercentExp", "=", 
     RowBox[{"100", "*", 
      RowBox[{"sdAtCStarExp", "/", "lambdaMaxExp"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<c* (care level at max mean \[Lambda])\>\"", "->", 
      "cStarExp"}], ",", 
     RowBox[{"\"\<max mean \[Lambda]\>\"", "->", "lambdaMaxExp"}], ",", 
     RowBox[{"\"\<SD(\[Lambda]) at c*\>\"", "->", "sdAtCStarExp"}], ",", 
     RowBox[{"\"\<SD as % of max mean \[Lambda]\>\"", "->", 
      "sdPercentExp"}]}], "}"}]}]}]], "Input",
