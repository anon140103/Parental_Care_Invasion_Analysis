Cell[CellGroupData[{

Cell["Deterministic Shape", "Title",
 CellChangeTimes->{{3.9804809548500347`*^9, 
  3.9804809619517117`*^9}},ExpressionUUID->"21dcdefd-ce8e-46d5-83f6-\
8c8cb45ef99b"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Aexpr", "[", 
      RowBox[{"th_", ",", "v0_", ",", "sj_", ",", "ss_", ",", "me_", ",", 
       RowBox[{"Kval_", ":", "250"}]}], "]"}], ":=", 
     RowBox[{"Kval", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"v0", "/", "sj"}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"(", 
               RowBox[{"th", "/", "me"}], ")"}]}], ")"}]}], ")"}], "/", 
          "ss"}], ")"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Care", " ", "mutant", " ", "invading", " ", "no"}], "-", 
     RowBox[{"care", " ", "resident"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getFit", "[", 
      RowBox[{"params_", ",", 
       RowBox[{"shape_String", ":", "\"\<Exp\>\""}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Mu]res", ",", "rres", ",", "\[Nu]res", ",", "\[Sigma]Jres", ",", 
         "\[Mu]mut", ",", "rmut", ",", "\[Nu]mut", ",", "\[Sigma]Jmut", ",", 
         "A", ",", "mat", ",", "res", ",", "V"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Mu]res", ",", "rres", ",", "\[Nu]res", ",", "\[Sigma]Jres"}], 
          "}"}], "=", 
         RowBox[{
          RowBox[{"tradeOff", "[", "shape", "]"}], "[", 
          RowBox[{"params", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Mu]mut", ",", "rmut", ",", "\[Nu]mut", ",", "\[Sigma]Jmut"}], 
          "}"}], "=", 
         RowBox[{
          RowBox[{"tradeOff", "[", "shape", "]"}], "[", 
          RowBox[{"params", ",", "c"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"A", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"K", "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"\[Nu]res", "/", "\[Sigma]Jres"}], ")"}], "*", 
                   RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"(", 
                    RowBox[{"\[Mu]res", "/", "mE"}], ")"}]}], ")"}]}], ")"}], 
                 "/", "rres"}], ")"}]}], ")"}]}], ")"}], "/.", " ", 
           "params"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mat", "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Lambda]"}], "-", "mE", "-", "\[Mu]mut"}], ",", 
              
              RowBox[{"rmut", "*", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"A", "/", "K"}]}], ")"}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"mE", "*", "\[Sigma]Jmut"}], ",", 
              RowBox[{
               RowBox[{"-", "\[Lambda]"}], "-", "\[Nu]mut"}]}], "}"}]}], 
           "}"}], "/.", " ", "params"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Det", "[", "mat", "]"}], "==", "0"}], ",", "\[Lambda]"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"V", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Lambda]", "/.", " ", 
             RowBox[{"res", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/.", " ", "params"}], 
          "//", "Simplify"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"val", ",", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", 
              RowBox[{"V", "/.", " ", 
               RowBox[{"c", "->", "val"}]}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"val", ",", "0", ",", "2", ",", "0.01"}], "}"}]}], 
         "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.984460713788858*^9, 3.9844607156686296`*^9}},
