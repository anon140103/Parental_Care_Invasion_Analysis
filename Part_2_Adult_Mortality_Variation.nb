      RowBox[{
       RowBox[{"Normal", "[", "g", "]"}], ",", "_RGBColor", ",", "Infinity"}],
       "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ValueQ", "[", "meanYRange", "]"}], "&&", 
      RowBox[{"MatchQ", "[", 
       RowBox[{"meanYRange", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"_", "?", "NumericQ"}], ",", 
