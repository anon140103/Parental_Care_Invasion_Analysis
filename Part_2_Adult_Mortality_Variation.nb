 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extractXY2", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "d", "}"}], ",", 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "g", "]"}], ",", 
          RowBox[{
           RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", 
          "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"First", "[", "d", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeMeanSDOverlayDashed", "[", 
     RowBox[{"meanG_", ",", "sdG_", ",", "title_", ",", "panelLabel_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "meanData", ",", "sdData", ",", "xMin", ",", "xMax", ",", "meanMin", ",",
         "meanMax", ",", "sdMin", ",", "sdMax", ",", "meanPad", ",", "sdPad", 
        ",", "meanPR", ",", "sdPR", ",", "scale", ",", "meanPlot", ",", 
        "sdScaledPlot", ",", "sdTickVals", ",", "sdTickPos", ",", 
        "sdTicksRight", ",", "epilogContent"}], "}"}], ",", 
      RowBox[{
       RowBox[{"meanData", "=", 
        RowBox[{"extractXY2", "[", "meanG", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sdData", "=", 
        RowBox[{"extractXY2", "[", "sdG", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xMin", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"meanData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xMax", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"meanData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanMin", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"meanData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanMax", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"meanData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sdMin", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"sdData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sdMax", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"sdData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanPad", "=", 
        RowBox[{"0.05", "*", 
         RowBox[{"(", 
          RowBox[{"meanMax", "-", "meanMin"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
