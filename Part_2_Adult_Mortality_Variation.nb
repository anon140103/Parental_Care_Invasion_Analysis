Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getLineData", "[", "g_", "]"}], ":=", 
   RowBox[{"First", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "g", "]"}], ",", 
      RowBox[{
       RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getPlotColour", "[", "g_", "]"}], ":=", 
    RowBox[{"First", "@", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "g", "]"}], ",", "_RGBColor", ",", "Infinity"}],
       "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ValueQ", "[", "meanYRange", "]"}], "&&", 
      RowBox[{"MatchQ", "[", 
       RowBox[{"meanYRange", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"_", "?", "NumericQ"}], ",", 
          RowBox[{"_", "?", "NumericQ"}]}], "}"}]}], "]"}]}], ",", "Null", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"And", "[", 
        RowBox[{
         RowBox[{"ValueQ", "[", "overallMeanRExp", "]"}], ",", 
         RowBox[{"ValueQ", "[", "fit1", "]"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"allMeanDetValues", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"overallMeanRExp", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"fit1", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minMeanY", "=", 
         RowBox[{"Min", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxMeanY", "=", 
         RowBox[{"Max", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rangeMean", "=", 
         RowBox[{"maxMeanY", "-", "minMeanY"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"paddingMean", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"rangeMean", "==", "0"}], ",", "0.1", ",", 
           RowBox[{"0.05", "*", "rangeMean"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"meanYRange", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"minMeanY", "-", "paddingMean"}], ",", 
           RowBox[{"maxMeanY", "+", "paddingMean"}]}], "}"}]}]}], ",", 
       RowBox[{
        RowBox[{"allMeanDetValues", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"getLineData", "[", "plotExp", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"getLineData", "[", "plotOverallMeanAExp", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minMeanY", "=", 
         RowBox[{"Min", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxMeanY", "=", 
         RowBox[{"Max", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rangeMean", "=", 
         RowBox[{"maxMeanY", "-", "minMeanY"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"paddingMean", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"rangeMean", "==", "0"}], ",", "0.1", ",", 
           RowBox[{"0.05", "*", "rangeMean"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"meanYRange", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"minMeanY", "-", "paddingMean"}], ",", 
           RowBox[{"maxMeanY", "+", "paddingMean"}]}], "}"}]}]}]}], "]"}]}], 
    "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"detData", "=", 
   RowBox[{"getLineData", "[", "plotExp", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stochData", "=", 
    RowBox[{"getLineData", "[", "plotOverallMeanAExp", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"detCol", "=", 
   RowBox[{"getPlotColour", "[", "plotExp", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stochCol", "=", 
    RowBox[{"getPlotColour", "[", "plotOverallMeanAExp", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exponentialOneEntityA", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"detData", ",", "stochData"}], "}"}], ",", 
