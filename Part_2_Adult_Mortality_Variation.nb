 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extractXY", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "d", "}"}], ",", 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "g", "]"}], ",", 
          RowBox[{
           RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", 
          "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"First", "[", "d", "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeMeanSDOverlayFromPlots", "[", 
     RowBox[{"meanG_", ",", "sdG_", ",", "title_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "meanData", ",", "sdData", ",", "xMin", ",", "xMax", ",", "meanMin", ",",
         "meanMax", ",", "sdMin", ",", "sdMax", ",", "meanPad", ",", "sdPad", 
        ",", "meanPR", ",", "sdPR", ",", "scale", ",", "meanPlot", ",", 
        "sdScaledPlot", ",", "sdTickVals", ",", "sdTickPos", ",", 
        "sdTicksRight"}], "}"}], ",", 
      RowBox[{
       RowBox[{"meanData", "=", 
        RowBox[{"extractXY", "[", "meanG", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sdData", "=", 
        RowBox[{"extractXY", "[", "sdG", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"xMin", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"meanData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xMax", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"meanData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanMin", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"meanData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanMax", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"meanData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sdMin", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"sdData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sdMax", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"sdData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanPad", "=", 
        RowBox[{"0.05", "*", 
         RowBox[{"(", 
          RowBox[{"meanMax", "-", "meanMin"}], ")"}]}]}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"meanPad", "==", "0"}], ",", 
         RowBox[{"meanPad", "=", "0.1"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdPad", "=", 
        RowBox[{"0.05", "*", 
         RowBox[{"(", 
          RowBox[{"sdMax", "-", "sdMin"}], ")"}]}]}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sdPad", "==", "0"}], ",", 
         RowBox[{"sdPad", "=", "0.1"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanPR", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"meanMin", "-", "meanPad"}], ",", 
          RowBox[{"meanMax", "+", "meanPad"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sdPR", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"sdMax", "+", "sdPad"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"scale", "[", "y_", "]"}], ":=", 
        RowBox[{"Rescale", "[", 
         RowBox[{"y", ",", "sdPR", ",", "meanPR"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanPlot", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"meanData", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"PlotStyle", "->", "meanStyle"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"xMin", ",", "xMax"}], "}"}], ",", "meanPR"}], 
            "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdScaledPlot", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"scale", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
            "sdData"}], ")"}], ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"PlotStyle", "->", "sdStyle"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"xMin", ",", "xMax"}], "}"}], ",", "meanPR"}], 
            "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdTickVals", "=", 
        RowBox[{"N", "@", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"sdPR", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"sdPR", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "5"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sdTickPos", "=", 
        RowBox[{"scale", "/@", "sdTickVals"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdTicksRight", "=", 
        RowBox[{"MapThread", "[", 
