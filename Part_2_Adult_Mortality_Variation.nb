      RowBox[{
       RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
