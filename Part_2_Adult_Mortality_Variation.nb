              RowBox[{"xMin", ",", "xMax"}], "}"}], ",", "meanPR"}], 
            "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdTickVals", "=", 
        RowBox[{"N", "@", 
