    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nuVals", ",", 
        RowBox[{"(*", 
         RowBox[{"sampled", " ", "adult", " ", "mortality", " ", "values"}], 
         "*)"}], "\[IndentingNewLine]", "paramSets", ",", 
        RowBox[{"(*", 
         RowBox[{
         "full", " ", "parameter", " ", "sets", " ", "with", " ", "different",
           " ", "mortality", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
        "fitnessFixedC", ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "invasion", " ", "fitness", " ", "at", " ", "fixed", " ", "care", " ",
            "c"}], "=", "0.5"}], "*)"}], "\[IndentingNewLine]", 
        "resultsFixedC", ",", 
        RowBox[{"(*", 
         RowBox[{"paired", " ", 
          RowBox[{"(", 
           RowBox[{"adult", " ", "mortality", " ", "x", " ", "fitness"}], 
           ")"}], " ", "values"}], "*)"}], "\[IndentingNewLine]", 
        "fitnessByCare", ",", 
        RowBox[{"(*", 
         RowBox[{
         "invasion", " ", "fitness", " ", "across", " ", "all", " ", "care", " ",
           "levels"}], "*)"}], "\[IndentingNewLine]", "meanByCare", ",", 
        RowBox[{"(*", 
         RowBox[{"mean", " ", "fitness", " ", "across", " ", "care"}], "*)"}],
         "\[IndentingNewLine]", "sdByCare"}], "         ", 
       RowBox[{"(*", 
        RowBox[{
        "standard", " ", "deviation", " ", "of", " ", "fitness", " ", 
         "across", " ", "care"}], "*)"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"fix", " ", "seed"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"nuVals", "=", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"adultMortalityDist", "[", 
           RowBox[{"meanNu", ",", "kappa"}], "]"}], ",", "n"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Histogram", "[", 
         RowBox[{"nuVals", ",", "20", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Adult mortality (\[Nu])\>\"", 
             ",", "\"\<Frequency\>\""}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Adult mortality distribution (\>\"", "<>", "shape", 
            "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"paramSets", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"baseParamsAdult", ",", 
            RowBox[{"{", 
             RowBox[{"\[Nu]0", "->", "nu"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"nu", ",", "nuVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"fitnessFixedC", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"getFitFixedC", "[", 
           RowBox[{
            RowBox[{"paramSets", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "shape"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"resultsFixedC", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"nuVals", ",", "fitnessFixedC"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"resultsFixedC", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Adult mortality (\[Nu])\>\"", 
             ",", "\"\<Fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Fitness vs adult mortality (\>\"", "<>", "shape", 
            "<>", "\"\<, c = 0.5, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"fitnessByCare", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"getFitAtC", "[", 
               RowBox[{
                RowBox[{"paramSets", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", "c", ",", "shape"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}],
            "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c", ",", "careVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"meanByCare", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "fitnessByCare"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"sdByCare", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "fitnessByCare"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "plot", " ", "mean", " ", "invasion", " ", "fitness", " ", "as", " ", 
         "a", " ", "function", " ", "of", " ", "care"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"meanByCare", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Care (c)\>\"", 
             ",", "\"\<Mean fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Mean fitness vs care (\>\"", "<>", "shape", 
            "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "plot", " ", "standard", " ", "deviation", " ", "of", " ", "invasion",
          " ", "fitness", " ", "as", " ", "a", " ", "function", " ", "of", " ",
          "care"}], "*)"}], 
       RowBox[{"Print", "[", 
