Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"allMeanCurvesAExp", "=", 
    RowBox[{"{", 
     RowBox[{
     "meanFitnessByCareA10Exp", ",", "meanFitnessByCareA50Exp", ",", 
      "meanFitnessByCareA100Exp", ",", "meanFitnessByCareB10Exp", ",", 
      "meanFitnessByCareB50Exp", ",", "meanFitnessByCareB100Exp", ",", 
      "meanFitnessByCareC10Exp", ",", "meanFitnessByCareC50Exp", ",", 
      "meanFitnessByCareC100Exp"}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allSDCurvesAExp", "=", 
    RowBox[{"{", 
     RowBox[{
     "sdFitnessByCareA10Exp", ",", "sdFitnessByCareA50Exp", ",", 
      "sdFitnessByCareA100Exp", ",", "sdFitnessByCareB10Exp", ",", 
      "sdFitnessByCareB50Exp", ",", "sdFitnessByCareB100Exp", ",", 
      "sdFitnessByCareC10Exp", ",", "sdFitnessByCareC50Exp", ",", 
      "sdFitnessByCareC100Exp"}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"careValuesAExp", "=", 
    RowBox[{
     RowBox[{"allMeanCurvesAExp", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"overallMeanAExp", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"careValuesAExp", ",", 
       RowBox[{"Mean", "/@", 
        RowBox[{"Transpose", "[", 
         RowBox[{"allMeanCurvesAExp", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "]"}]}]}], 
      "}"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
