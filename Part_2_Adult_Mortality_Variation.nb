Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extractXY2", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "d", "}"}], ",", 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "g", "]"}], ",", 
          RowBox[{
           RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", 
          "Infinity"}], "]"}]}], ";", 
       RowBox[{"First", "[", "d", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fmt4", "[", "x_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"NumericQ", "[", "x", "]"}], ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"N", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Infinity", ",", "4"}], "}"}]}], "]"}], ",", "x"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"interpAt", "[", 
     RowBox[{"data_", ",", "x_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"SortBy", "[", 
        RowBox[{"data", ",", "First"}], "]"}], ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "x", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"adultCrossStatsFromPlots", "[", 
     RowBox[{"meanG_", ",", "sdG_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "meanData", ",", "sdData", ",", "maxSDPt", ",", "cAtMaxSD", ",", 
        "sdMax", ",", "meanAtCmaxSD", ",", "pctSDofMeanAtMaxSD", ",", 
        "maxMeanPt", ",", "cAtMaxMean", ",", "meanMax", ",", "sdAtCmaxMean", ",",
         "pctSDofMeanAtMaxMean"}], "}"}], ",", 
      RowBox[{
       RowBox[{"meanData", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"extractXY2", "[", "meanG", "]"}], ",", "First"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"sdData", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"extractXY2", "[", "sdG", "]"}], ",", "First"}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Max", " ", "SD", " ", "and", " ", "the", " ", "corresponding", " ", 
         "mean"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"maxSDPt", "=", 
        RowBox[{"First", "@", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"sdData", ",", "Last"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cAtMaxSD", "=", 
        RowBox[{"maxSDPt", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdMax", "=", 
        RowBox[{"maxSDPt", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanAtCmaxSD", "=", 
        RowBox[{"interpAt", "[", 
         RowBox[{"meanData", ",", "cAtMaxSD"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pctSDofMeanAtMaxSD", "=", 
        RowBox[{"100", " ", 
         RowBox[{"sdMax", "/", "meanAtCmaxSD"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Max", " ", "mean", " ", "and", " ", "the", " ", "corresponding", " ",
          "SD"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"maxMeanPt", "=", 
        RowBox[{"First", "@", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"meanData", ",", "Last"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cAtMaxMean", "=", 
        RowBox[{"maxMeanPt", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanMax", "=", 
        RowBox[{"maxMeanPt", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdAtCmaxMean", "=", 
        RowBox[{"interpAt", "[", 
         RowBox[{"sdData", ",", "cAtMaxMean"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pctSDofMeanAtMaxMean", "=", 
        RowBox[{"100", " ", 
         RowBox[{"sdAtCmaxMean", "/", "meanMax"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<c at Max SD\>\"", "->", "cAtMaxSD"}], ",", 
         RowBox[{"\"\<Max SD(\[Lambda])\>\"", "->", "sdMax"}], ",", 
         RowBox[{"\"\<Mean \[Lambda] at c(Max SD)\>\"", "->", 
          "meanAtCmaxSD"}], ",", 
         RowBox[{"\"\<Max SD as % of Mean \[Lambda] at c(Max SD)\>\"", "->", 
          "pctSDofMeanAtMaxSD"}], ",", 
         RowBox[{"\"\<c at Max Mean \[Lambda]\>\"", "->", "cAtMaxMean"}], ",", 
         RowBox[{"\"\<Max Mean \[Lambda]\>\"", "->", "meanMax"}], ",", 
         RowBox[{"\"\<SD(\[Lambda]) at c(Max Mean)\>\"", "->", 
          "sdAtCmaxMean"}], ",", 
         RowBox[{"\"\<SD at c(Max Mean) as % of Max Mean \[Lambda]\>\"", "->",
           "pctSDofMeanAtMaxMean"}]}], "|>"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"adultStatsByShape", "=", 
