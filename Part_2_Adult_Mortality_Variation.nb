Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extractXY2", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "d", "}"}], ",", 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "g", "]"}], ",", 
          RowBox[{
           RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", 
          "Infinity"}], "]"}]}], ";", 
       RowBox[{"First", "[", "d", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"maxYFromPlot2", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xy", "=", 
        RowBox[{"extractXY2", "[", "g", "]"}]}], "}"}], ",", 
      RowBox[{"Max", "[", 
       RowBox[{"xy", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fmt4b", "[", "x_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"NumericQ", "[", "x", "]"}], ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"N", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Infinity", ",", "4"}], "}"}]}], "]"}], ",", "x"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"adultMaxStats", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"shapes", ",", "meanPlots", ",", "sdPlots", ",", "rows"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"shapes", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<Exponential\>\"", ",", "\"\<Saturating\>\"", 
          ",", "\"\<Sigmoid\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanPlots", "=", 
        RowBox[{"{", 
         RowBox[{
         "plotOverallMeanAExp", ",", "plotOverallMeanASat", ",", 
          "plotOverallMeanASig"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdPlots", "=", 
        RowBox[{"{", 
         RowBox[{
         "plotOverallSDAExp", ",", "plotOverallSDASat", ",", 
          "plotOverallSDASig"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"shape", ",", "meanG", ",", "sdG"}], "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"maxMean", ",", "maxSD", ",", "pct"}], "}"}], ",", 
              RowBox[{
               RowBox[{"maxMean", "=", 
                RowBox[{"maxYFromPlot2", "[", "meanG", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"maxSD", "=", 
                RowBox[{"maxYFromPlot2", "[", "sdG", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"pct", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"maxMean", "==", "0"}], ",", 
                  RowBox[{"Missing", "[", "\"\<Undefined\>\"", "]"}], ",", 
                  RowBox[{"100", " ", 
                   RowBox[{"maxSD", "/", "maxMean"}]}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"shape", ",", "maxSD", ",", "maxMean", ",", "pct"}], 
                "}"}]}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"shapes", ",", "meanPlots", ",", "sdPlots"}], "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"rows", "/.", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"s_", ",", "sd_", ",", "mn_", ",", "pc_"}], "}"}], ":>", 
              RowBox[{"{", 
               RowBox[{"s", ",", 
                RowBox[{"fmt4b", "[", "sd", "]"}], ",", 
                RowBox[{"fmt4b", "[", "mn", "]"}], ",", 
                RowBox[{"fmt4b", "[", "pc", "]"}]}], "}"}]}]}], ")"}], ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Trade-off shape\>\"", 
             ",", "\"\<Max SD(\[Lambda])\>\"", 
             ",", "\"\<Max Mean \[Lambda]\>\"", 
             ",", "\"\<Max SD as % of Max Mean\>\""}], "}"}]}], "]"}], ",", 
         RowBox[{"Frame", "->", "All"}], ",", 
         RowBox[{"Alignment", "->", "Center"}], ",", 
         RowBox[{"Background", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Lighter", "[", 
               RowBox[{"Gray", ",", "0.95"}], "]"}], ",", 
              RowBox[{"{", "White", "}"}]}], "}"}]}], "}"}]}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", "adultMaxStats"}], "Input",\

