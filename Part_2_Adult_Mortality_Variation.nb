           "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"sdTickPos", ",", "sdTickVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"epilogContent", "=", 
        RowBox[{"If", "[", 
