            RowBox[{"fit3", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minMeanY", "=", 
         RowBox[{"Min", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxMeanY", "=", 
         RowBox[{"Max", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rangeMean", "=", 
         RowBox[{"maxMeanY", "-", "minMeanY"}]}], ";", "\[IndentingNewLine]", 
        
