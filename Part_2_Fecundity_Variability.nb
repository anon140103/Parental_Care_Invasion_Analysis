 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeOverlay", "[", 
     RowBox[{"fit_", ",", "mean_", ",", "lab_"}], "]"}], ":=", 
    RowBox[{"addPanelLabel", "[", 
     RowBox[{
      RowBox[{"ListPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fit", ",", "mean"}], "}"}], ",", 
        RowBox[{"Joined", "->", "True"}], ",", 
