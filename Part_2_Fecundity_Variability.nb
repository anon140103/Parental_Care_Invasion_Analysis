         RowBox[{
         "parameter", " ", "sets", " ", "with", " ", "different", " ", "r", " ",
           "values"}], "*)"}], "\[IndentingNewLine]", "fitnessFixedC", ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "fitness", " ", "values", " ", "at", " ", "fixed", " ", "care", " ",
            "c"}], "=", "0.5"}], "*)"}], "\[IndentingNewLine]", 
        "resultsFixedC", ",", 
        RowBox[{"(*", 
         RowBox[{"paired", " ", 
          RowBox[{"(", 
           RowBox[{"r", " ", "x", " ", "fitness"}], ")"}], " ", "values"}], 
         "*)"}], "\[IndentingNewLine]", "fitnessByCare", ",", 
        RowBox[{"(*", 
         RowBox[{
         "fitness", " ", "values", " ", "across", " ", "all", " ", "care", " ",
           "levels"}], "*)"}], "\[IndentingNewLine]", "meanByCare", ",", 
        RowBox[{"(*", 
         RowBox[{"mean", " ", "fitness", " ", "across", " ", "care"}], "*)"}],
         "\[IndentingNewLine]", "sdByCare"}], "         ", 
       RowBox[{"(*", 
        RowBox[{
        "standard", " ", "deviation", " ", "of", " ", "fitness", " ", 
         "across", " ", "care"}], "*)"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"fix", " ", "seed"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"draw", " ", "random", " ", "fecundity", " ", "values"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"rVals", "=", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"fecundityDist", "[", 
           RowBox[{"meanR", ",", "kappa"}], "]"}], ",", "n"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"show", " ", "sampled", " ", "fecundity", " ", "values"}], 
        "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"Histogram", "[", 
         RowBox[{"rVals", ",", "20", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<Fecundity (r)\>\"", ",", "\"\<Frequency\>\""}], 
            "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Fecundity distribution (\>\"", "<>", "shape", 
            "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "build", " ", "parameter", " ", "sets", " ", "by", " ", "replacing", " ",
          "r"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"paramSets", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"baseParamsFecundity", ",", 
            RowBox[{"{", 
             RowBox[{"r", "->", "rval"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"rval", ",", "rVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "invasion", " ", "fitness", " ", "at", " ", "fixed", " ", "care", " ",
           "c"}], "=", "0.5"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitnessFixedC", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"getFitFixedC", "[", 
           RowBox[{
            RowBox[{"paramSets", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "shape"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"pair", " ", "r", " ", "with", " ", "fitness"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"resultsFixedC", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"rVals", ",", "fitnessFixedC"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "fitness", " ", "vs", " ", "fecundity", " ", "at", " ", "c"}], "=", 
         "0.5"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"resultsFixedC", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Fecundity (r)\>\"", 
             ",", "\"\<Fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Fitness vs fecundity (\>\"", "<>", "shape", 
            "<>", "\"\<, c = 0.5, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "invasion", " ", "fitness", " ", "across", " ", "full", " ", "care", " ",
          "range"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitnessByCare", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"getFitAtC", "[", 
               RowBox[{
                RowBox[{"paramSets", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", "c", ",", "shape"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}],
            "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c", ",", "careVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"mean", " ", "fitness", " ", "across", " ", "care"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"meanByCare", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "fitnessByCare"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "standard", " ", "deviation", " ", "of", " ", "fitness", " ", 
         "across", " ", "care"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"sdByCare", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "fitnessByCare"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"mean", " ", "fitness", " ", "vs", " ", "care"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"meanByCare", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Care (c)\>\"", 
             ",", "\"\<Mean fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Mean fitness vs care (fecundity r, \>\"", "<>", 
            "shape", "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"SD", " ", "of", " ", "fitness", " ", "vs", " ", "care"}], 
        "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"sdByCare", ",", 
