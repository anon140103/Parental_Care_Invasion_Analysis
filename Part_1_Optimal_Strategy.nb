Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"params2", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Theta]", "->", "0.8"}], ",", 
      RowBox[{"\[Nu]0", "->", "0.1"}], ",", 
      RowBox[{"\[Sigma]J0", "->", "0.323"}], ",", 
      RowBox[{"s", "->", "6"}], ",", 
      RowBox[{"a", "->", "6"}], ",", 
      RowBox[{"mE", "->", "0.2"}], ",", 
      RowBox[{"K", "->", "250"}]}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shapes2", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Exp\>\"", ",", "\"\<Saturating\>\"", ",", "\"\<Sigmoid\>\"", 
     ",", " ", "\"\<Linear\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"labels", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<\[Mu](c)\>\"", ",", "\"\<r(c)\>\"", ",", "\"\<\[Nu](c)\>\"", 
     ",", "\"\<\[Sigma]J(c)\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"colors2", "=", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Purple", ",", " ", "Red", ",", " ", "Green"}], 
     "}"}]}], ";"}], "  ", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"traitVal2", "[", 
     RowBox[{"shape_", ",", "i_", ",", "c_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"tradeOff", "[", "shape", "]"}], "[", 
      RowBox[{"params2", ",", "c"}], "]"}], "[", 
     RowBox[{"[", "i", "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plots2", "=", 
