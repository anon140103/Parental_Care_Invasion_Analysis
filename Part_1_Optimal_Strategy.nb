     RowBox[{"getFlippedFit", "[", 
      RowBox[{"params_", ",", 
       RowBox[{"shape_String", ":", "\"\<Exp\>\""}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Mu]res", ",", "rres", ",", "\[Nu]res", ",", "\[Sigma]Jres", ",", 
         "\[Mu]mut", ",", "rmut", ",", "\[Nu]mut", ",", "\[Sigma]Jmut", ",", 
         "A", ",", "mat", ",", "res", ",", "V"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Resident", "=", "c"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Mu]res", ",", "rres", ",", "\[Nu]res", ",", "\[Sigma]Jres"}], 
          "}"}], "=", 
         RowBox[{
          RowBox[{"tradeOff", "[", "shape", "]"}], "[", 
          RowBox[{"params", ",", "c"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Mutant", "=", 
          RowBox[{"no", "-", 
           RowBox[{"care", " ", 
            RowBox[{"(", 
             RowBox[{"c", "=", "0"}], ")"}]}]}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Mu]mut", ",", "rmut", ",", "\[Nu]mut", ",", "\[Sigma]Jmut"}], 
          "}"}], "=", 
         RowBox[{
          RowBox[{"tradeOff", "[", "shape", "]"}], "[", 
          RowBox[{"params", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Resident", " ", "equilibrium"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"A", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"K", "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"\[Nu]res", "/", "\[Sigma]Jres"}], ")"}], "*", 
                   RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"(", 
                    RowBox[{"\[Mu]res", "/", "mE"}], ")"}]}], ")"}]}], ")"}], 
                 "/", "rres"}], ")"}]}], ")"}]}], ")"}], "/.", " ", 
           "params"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Mutant", " ", "Jacobian"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"mat", "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Lambda]"}], "-", "mE", "-", "\[Mu]mut"}], ",", 
              
              RowBox[{"rmut", "*", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"A", "/", "K"}]}], ")"}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"mE", "*", "\[Sigma]Jmut"}], ",", 
              RowBox[{
               RowBox[{"-", "\[Lambda]"}], "-", "\[Nu]mut"}]}], "}"}]}], 
           "}"}], "/.", " ", "params"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Det", "[", "mat", "]"}], "==", "0"}], ",", "\[Lambda]"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"V", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Lambda]", "/.", " ", 
             RowBox[{"res", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/.", " ", "params"}], 
          "//", "Simplify"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"val", ",", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", 
              RowBox[{"V", "/.", " ", 
               RowBox[{"c", "->", "val"}]}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"val", ",", "0", ",", "2", ",", "0.01"}], "}"}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"runTradeOffAnalysis", "[", 
      RowBox[{
       RowBox[{"shape_String", ":", "\"\<Exp\>\""}], ",", 
       RowBox[{"aVal_", ":", "6"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "best", ",", "bestRules", ",", "Aopt", ",", "AoptTransformed", ",", 
         "\[Lambda]opt", ",", "cStarOpt", ",", "paramsOpt", ",", 
         "fitCareInvades", ",", "fitNoCareInvades", ",", "plot1", ",", 
         "\[IndentingNewLine]", "muResSym", ",", "rResSym", ",", "nuResSym", ",",
          "sigmaJSym", ",", "AresSymbolic"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\\n=== Running trade-off analysis for shape: \>\"", ",",
           "shape", ",", "\"\< ===\>\""}], "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"muResSym", "=", "th"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rResSym", "=", 
         RowBox[{"ss", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"1", "-", "th"}], ")"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nuResSym", "=", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "v0"}], ")"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"1", "-", "th"}], ")"}]}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sigmaJSym", "=", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "sj"}], ")"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"1", "-", "th"}], ")"}]}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "resident", " ", "equilibrium", " ", "from", " ", "transformed", " ",
           "resident", " ", "traits"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"AresSymbolic", "=", 
         RowBox[{"(", 
          RowBox[{"250", "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"nuResSym", "/", "sigmaJSym"}], ")"}], "*", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   RowBox[{"(", 
                    RowBox[{"muResSym", "/", "me"}], ")"}]}], ")"}]}], ")"}], 
               "/", "rResSym"}], ")"}]}], ")"}]}], ")"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Optimise", " ", "for", " ", "the", " ", "best", " ", 
           "parameters"}], ",", " ", 
          RowBox[{
           RowBox[{
           "and", " ", "ensuring", " ", "that", " ", "resident", " ", 
            "equilibrium"}], " ", ">", "100"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"best", "=", 
         RowBox[{"NMaximize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"First", "[", 
              RowBox[{"maxLambda", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"\[Theta]", "->", "th"}], ",", 
                  RowBox[{"\[Nu]0", "->", "v0"}], ",", 
                  RowBox[{"\[Sigma]J0", "->", "sj"}], ",", 
                  RowBox[{"s", "->", "ss"}], ",", 
                  RowBox[{"mE", "->", "me"}], ",", 
                  RowBox[{"K", "->", "250"}], ",", 
                  RowBox[{"a", "->", "aVal"}]}], "}"}], ",", "shape"}], "]"}],
               "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"0.1", "<", "th", "<", "0.8"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"0.1", "<", "v0", "<", "0.5"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"0.3", "<", "sj", "<", "0.8"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"2", "<", "ss", "<", "6"}], ",", "\[IndentingNewLine]", 
             RowBox[{"0.05", "<", "me", "<", "0.2"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"AresSymbolic", ">", "100"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"th", ",", "v0", ",", "sj", ",", "ss", ",", "me"}], "}"}],
            ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", "\"\<DifferentialEvolution\>\"", "}"}]}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"bestRules", "=", 
         RowBox[{"Last", "[", "best", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"paramsOpt", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Theta]", "->", "th"}], "/.", " ", "bestRules"}], ",", 
           RowBox[{
            RowBox[{"\[Nu]0", "->", "v0"}], "/.", " ", "bestRules"}], ",", 
           RowBox[{
            RowBox[{"\[Sigma]J0", "->", "sj"}], "/.", " ", "bestRules"}], ",", 
           RowBox[{
            RowBox[{"s", "->", "ss"}], "/.", " ", "bestRules"}], ",", 
           RowBox[{
            RowBox[{"mE", "->", "me"}], "/.", " ", "bestRules"}], ",", 
           RowBox[{"K", "->", "250"}], ",", 
           RowBox[{"a", "->", "aVal"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Lambda]opt", ",", "cStarOpt"}], "}"}], "=", 
         RowBox[{"maxLambda", "[", 
          RowBox[{"paramsOpt", ",", "shape"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "muResOpt", ",", "rResOpt", ",", "nuResOpt", ",", "sigmaJResOpt"}], 
          "}"}], "=", 
         RowBox[{
          RowBox[{"tradeOff", "[", "shape", "]"}], "[", 
          RowBox[{"paramsOpt", ",", "0"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AoptTransformed", "=", 
         RowBox[{"N", "[", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"K", "/.", " ", "paramsOpt"}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"nuResOpt", "/", "sigmaJResOpt"}], ")"}], "*", 
                  RowBox[{"(", 
                   RowBox[{"1", "+", 
                    RowBox[{"(", 
                    RowBox[{"muResOpt", "/", 
                    RowBox[{"(", 
                    RowBox[{"mE", "/.", " ", "paramsOpt"}], ")"}]}], ")"}]}], 
                   ")"}]}], ")"}], "/", "rResOpt"}], ")"}]}], ")"}]}], ")"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Aopt", "=", "AoptTransformed"}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Optimal parameters: \>\"", ",", "bestRules"}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Lambda]_max = \>\"", ",", "\[Lambda]opt"}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Optimal care level (c*) = \>\"", ",", "cStarOpt"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Resident equilibrium A = \>\"", ",", "Aopt"}], "]"}], ";",
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Plot", " ", "the", " ", "invasion", " ", "curves"}], "*)"}],
         "\[IndentingNewLine]", 
        RowBox[{"fitCareInvades", "=", 
         RowBox[{"getFit", "[", 
          RowBox[{"paramsOpt", ",", "shape"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fitNoCareInvades", "=", 
         RowBox[{"getFlippedFit", "[", 
          RowBox[{"paramsOpt", ",", "shape"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"plot1", "=", 
         RowBox[{"ListPlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"fitCareInvades", ",", "fitNoCareInvades"}], "}"}], ",", 
           RowBox[{"Joined", "->", "True"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Care invading no-care\>\"", 
              ",", "\"\<No-care invading care\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<c\>\"", ",", "\"\<\[Lambda]\>\""}], "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", 
            
            RowBox[{"\"\<Invasion analysis (\>\"", "<>", "shape", 
             "<>", "\"\<)\>\""}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "plot1", "]"}], ";"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", "\n"}]}]], "Input",
