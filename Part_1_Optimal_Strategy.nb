Cell[CellGroupData[{

Cell["Saturating", "Subtitle",
 CellChangeTimes->{{3.9766813660424757`*^9, 
  3.97668136911222*^9}},ExpressionUUID->"9f00e130-91e9-40a4-863d-\
59d62004f7ef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"paramsSat", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Theta]", "->", "0.79999997"}], ",", 
      RowBox[{"\[Nu]0", "->", "0.100004"}], ",", 
      RowBox[{"\[Sigma]J0", "->", "0.323837"}], ",", 
      RowBox[{"s", "->", "5.99998"}], ",", 
      RowBox[{"mE", "->", "0.1999999"}], ",", 
      RowBox[{"K", "->", "250"}], ",", 
      RowBox[{"a", "->", "6"}]}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"fitCareSat", "=", 
   RowBox[{"getFit", "[", 
    RowBox[{"paramsSat", ",", "\"\<Saturating\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitNoCareSat", "=", 
    RowBox[{"getFlippedFit", "[", 
     RowBox[{"paramsSat", ",", "\"\<Saturating\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colCare", "=", 
   RowBox[{"RGBColor", "[", 
    RowBox[{"0.121", ",", "0.467", ",", "0.705"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"colNoCare", "=", 
    RowBox[{"GrayLevel", "[", "0.3", "]"}]}], ";"}], "   ", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plotStyleSat", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"colCare", ",", "Thick"}], "]"}], ",", 
      RowBox[{"Directive", "[", 
       RowBox[{"colNoCare", ",", "Thick", ",", "Dashed"}], "]"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"interpCareSat", "=", 
   RowBox[{"Interpolation", "[", "fitCareSat", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"interpNoCareSat", "=", 
    RowBox[{"Interpolation", "[", "fitNoCareSat", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cStarSat", "=", "0.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cCrossSat", "=", "0.55"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"yStarSat", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"interpCareSat", "[", "cStarSat", "]"}], ",", "Indeterminate"}],
      "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yCrossSat", "=", 
    RowBox[{"Quiet", "@", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"interpNoCareSat", "[", "cCrossSat", "]"}], ",", 
       "Indeterminate"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Saturating (exact params) \[LongDash] c* = \>\"", ",", 
    "cStarSat", ",", "\"\< -> \[Lambda] = \>\"", ",", "yStarSat"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Saturating (exact params) \[LongDash] crossing c = \>\"", ",",
      "cCrossSat", ",", "\"\< -> \[Lambda] = \>\"", ",", "yCrossSat"}], "]"}],
    ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", "Plot", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotSatHardDots", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fitCareSat", ",", "fitNoCareSat"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "plotStyleSat"}], ",", 
      RowBox[{"Joined", "->", "True"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<c\>\"", ",", "\"\<\[Lambda]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Invasion analysis (Saturating)\>\""}], ",", 
