       RowBox[{"Scaled", "[", "0.03", "]"}]}], ",", 
      RowBox[{"ImagePadding", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"60", ",", "110"}], "}"}], ",", 
         RowBox[{"{", 
