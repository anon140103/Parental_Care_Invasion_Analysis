   RowBox[{"PlotStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Purple", ",", "Thick"}], "]"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Care (c)\>\"", ",", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
