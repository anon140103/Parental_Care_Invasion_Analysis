Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"paramsExp", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Theta]", "->", "0.8"}], ",", 
      RowBox[{"\[Nu]0", "->", "0.1"}], ",", 
      RowBox[{"\[Sigma]J0", "->", "0.323823"}], ",", 
      RowBox[{"s", "->", "6"}], ",", 
      RowBox[{"mE", "->", "0.2"}], ",", 
      RowBox[{"K", "->", "250"}], ",", 
      RowBox[{"a", "->", "6"}]}], "}"}]}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fitCareExp", "=", 
    RowBox[{"getFit", "[", 
     RowBox[{"paramsExp", ",", "\"\<Exp\>\""}], "]"}]}], ";"}], 
  "          "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitNoCareExp", "=", 
    RowBox[{"getFlippedFit", "[", 
     RowBox[{"paramsExp", ",", "\"\<Exp\>\""}], "]"}]}], ";"}], "   ", "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colCare", "=", 
   RowBox[{"RGBColor", "[", 
    RowBox[{"0.121", ",", "0.467", ",", "0.705"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"colNoCare", "=", 
    RowBox[{"GrayLevel", "[", "0.3", "]"}]}], ";"}], "  ", 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plotStyleExp", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"colCare", ",", "Thick"}], "]"}], ",", 
      RowBox[{"Directive", "[", 
       RowBox[{"colNoCare", ",", "Thick", ",", "Dashed"}], "]"}]}], "}"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"interpCareExp", "=", 
   RowBox[{"Interpolation", "[", "fitCareExp", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"interpNoCareExp", "=", 
    RowBox[{"Interpolation", "[", "fitNoCareExp", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dotMax", "=", 
    RowBox[{"{", 
     RowBox[{"0.32", ",", "0.24"}], "}"}]}], ";"}], "   "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cCrossExp", "=", "1.305"}], ";"}], "       ", 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yCrossExp", "=", 
    RowBox[{"Quiet", "@", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"interpNoCareExp", "[", "cCrossExp", "]"}], ",", 
       "Indeterminate"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Exponential \[LongDash] optimal care = \>\"", ",", "dotMax"}],
    "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Exponential \[LongDash] crossing c = \>\"", ",", "cCrossExp",
      ",", "\"\< -> \[Lambda] = \>\"", ",", "yCrossExp"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotExpHardDots", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fitCareExp", ",", "fitNoCareExp"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "plotStyleExp"}], ",", 
      RowBox[{"Joined", "->", "True"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<c\>\"", ",", "\"\<\[Lambda]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Invasion analysis (Exponential)\>\""}], 
      ",", 
      RowBox[{"GridLines", "->", "Automatic"}], ",", 
      RowBox[{"PlotRangePadding", "->", 
       RowBox[{"Scaled", "[", "0.03", "]"}]}], ",", 
      RowBox[{"ImagePadding", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"60", ",", "110"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"50", ",", "60"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", 
        RowBox[{"Red", ",", 
         RowBox[{"PointSize", "[", "Large", "]"}], ",", 
         RowBox[{"Point", "[", "dotMax", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<c* = \>\"", ",", 
