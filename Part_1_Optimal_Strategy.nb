  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"tradeOff", "[", "\"\<Exp\>\"", "]"}], "[", 
     RowBox[{"params", ",", "c"}], "]"}], "[", 
    RowBox[{"[", "3", "]"}], "]"}], ",", 
