           RowBox[{
            RowBox[{"(", 
             RowBox[{"y", "-", 
              RowBox[{"localPeak1", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}]}], ")"}]}],
         "/", "1.1"}], "]"}]}], "+", 
     RowBox[{"1.7", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
