Cell[CellGroupData[{

Cell["Sigmoid", "Subtitle",
 CellChangeTimes->{{3.976680823607629*^9, 
  3.9766808332685947`*^9}},ExpressionUUID->"bcc3d98c-0373-474a-9816-\
1d608bf82648"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"paramsSig", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Theta]", "->", "0.8"}], ",", 
      RowBox[{"\[Nu]0", "->", "0.1"}], ",", 
      RowBox[{"\[Sigma]J0", "->", "0.323823"}], ",", 
      RowBox[{"s", "->", "6"}], ",", 
      RowBox[{"mE", "->", "0.2"}], ",", 
      RowBox[{"K", "->", "250"}], ",", 
      RowBox[{"a", "->", "6"}]}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fitCareSig", "=", 
   RowBox[{"getFit", "[", 
    RowBox[{"paramsSig", ",", "\"\<Sigmoid\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitNoCareSig", "=", 
    RowBox[{"getFlippedFit", "[", 
     RowBox[{"paramsSig", ",", "\"\<Sigmoid\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Colour", " ", "setup"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"colCare", "=", 
   RowBox[{"RGBColor", "[", 
    RowBox[{"0.121", ",", "0.467", ",", "0.705"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"colNoCare", "=", 
    RowBox[{"GrayLevel", "[", "0.3", "]"}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"grey", " ", "dashed"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotStyleSig", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"colCare", ",", "Thick"}], "]"}], ",", 
      RowBox[{"Directive", "[", 
       RowBox[{"colNoCare", ",", "Thick", ",", "Dashed"}], "]"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "Interpolations", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"interpCareSig", "=", 
   RowBox[{"Interpolation", "[", "fitCareSig", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"interpNoCareSig", "=", 
    RowBox[{"Interpolation", "[", "fitNoCareSig", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Key", " ", "points"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"cStarSig", "=", "0.56"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cCross1", "=", "0.27"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cCross2", "=", "1.275"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yStarSig", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"interpCareSig", "[", "cStarSig", "]"}], ",", "Indeterminate"}],
      "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"yCross1", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"interpNoCareSig", "[", "cCross1", "]"}], ",", 
      "Indeterminate"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yCross2", "=", 
    RowBox[{"Quiet", "@", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"interpNoCareSig", "[", "cCross2", "]"}], ",", 
       "Indeterminate"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Print", " ", "diagnostics"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Sigmoid \[LongDash] c* = \>\"", ",", "cStarSig", 
    ",", "\"\< -> \[Lambda] = \>\"", ",", "yStarSig"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Sigmoid \[LongDash] crossing 1 c = \>\"", ",", "cCross1", 
    ",", "\"\< -> \[Lambda] = \>\"", ",", "yCross1"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Sigmoid \[LongDash] crossing 2 c = \>\"", ",", "cCross2", 
     ",", "\"\< -> \[Lambda] = \>\"", ",", "yCross2"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "Plot", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plotSigHardDots", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
