             RowBox[{
              RowBox[{"-", "k"}], "*", 
              RowBox[{"(", 
               RowBox[{"x", "-", "c0"}], ")"}]}], "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"L0", "=", 
         RowBox[{"L", "[", "0", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Lnorm", "[", "x_", "]"}], ":=", 
         RowBox[{
          RowBox[{"(", 
