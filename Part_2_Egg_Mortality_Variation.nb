Cell[CellGroupData[{

Cell["Big Function", "Subtitle",
 CellChangeTimes->{{3.9787582136127157`*^9, 
  3.978758216932085*^9}},ExpressionUUID->"ca0a6d0a-310c-47a7-97aa-\
92b09118b443"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runEggMortalityCase", "[", 
     RowBox[{"kappa_", ",", "n_", ",", "seed_", ",", 
      RowBox[{"shape_String", ":", "\"\<Exp\>\""}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eggVals", ",", 
        RowBox[{"(*", 
         RowBox[{"sampled", " ", "egg", " ", "mortality", " ", "values"}], 
         " ", "*)"}], "\[IndentingNewLine]", "paramSets", ",", 
        RowBox[{"(*", 
         RowBox[{
         "full", " ", "parameter", " ", "sets", " ", "with", " ", "different",
           " ", "values"}], "*)"}], "\[IndentingNewLine]", "fitnessFixedC", ",", 
        RowBox[{"(*", 
         RowBox[{
         "invasion", " ", "fitness", " ", "at", " ", "fixed", " ", "care"}], 
         "*)"}], "\[IndentingNewLine]", "resultsFixedC", ",", 
        RowBox[{"(*", 
         RowBox[{"paired", " ", 
          RowBox[{"(", 
           RowBox[{"egg", " ", "mortality", " ", "x", " ", "fitness"}], ")"}],
           " ", "values"}], "*)"}], "\[IndentingNewLine]", "fitnessByCare", ",", 
        RowBox[{"(*", 
         RowBox[{"invasion", " ", "fitness", " ", "across", " ", "care"}], 
         "*)"}], "\[IndentingNewLine]", "meanByCare", ",", 
        RowBox[{"(*", 
         RowBox[{"mean", " ", "fitness", " ", "across", " ", "care"}], "*)"}],
         "\[IndentingNewLine]", "sdByCare"}], "         ", 
       RowBox[{"(*", 
        RowBox[{"SD", " ", "of", " ", "fitness", " ", "across", " ", "care"}],
         "*)"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"fix", " ", "seed"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"draw", " ", "egg", " ", "mortality", " ", "values"}], "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{"eggVals", "=", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"eggMortalityDist", "[", 
           RowBox[{"meanEgg", ",", "kappa"}], "]"}], ",", "n"}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "plot", " ", "sampled", " ", "egg", " ", "mortality", " ", 
         "distribution"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"Histogram", "[", 
         RowBox[{"eggVals", ",", "20", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Egg mortality (\[Theta])\>\"", 
             ",", "\"\<Frequency\>\""}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Egg mortality distribution (\>\"", "<>", "shape", 
            "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "build", " ", "full", " ", "parameter", " ", "sets", " ", "by", " ", 
         "replacing", " ", "egg", " ", "death", " ", "rate"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"paramSets", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"baseParamsEgg", ",", 
            RowBox[{"{", 
             RowBox[{"\[Theta]", "->", "th"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"th", ",", "eggVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "invasion", " ", "fitness", " ", "at", " ", "fixed", " ", "care", " ",
           "c"}], "=", "0.5"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitnessFixedC", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"getFitFixedC", "[", 
           RowBox[{
            RowBox[{"paramSets", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "shape"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "pair", " ", "egg", " ", "mortality", " ", "with", " ", "fitness"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"resultsFixedC", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"eggVals", ",", "fitnessFixedC"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "plot", " ", "fitness", " ", "vs", " ", "egg", " ", "mortality"}], 
        "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"resultsFixedC", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Egg mortality (\[Theta])\>\"", 
             ",", "\"\<Fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Fitness vs egg mortality (\>\"", "<>", "shape", 
            "<>", "\"\<, c = 0.5, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"invasion", " ", "fitness", " ", "across", " ", "care"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitnessByCare", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"getFitAtC", "[", 
               RowBox[{
                RowBox[{"paramSets", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", "c", ",", "shape"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}],
            "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c", ",", "careVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"mean", " ", "fitness", " ", "across", " ", "care"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"meanByCare", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "fitnessByCare"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"SD", " ", "of", " ", "fitness", " ", "across", " ", "care"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"sdByCare", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "fitnessByCare"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"plot", " ", "mean", " ", "fitness", " ", "vs", " ", "care"}],
         "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"meanByCare", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Care (c)\>\"", 
             ",", "\"\<Mean fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Mean fitness vs care (\>\"", "<>", "shape", 
            "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "plot", " ", "SD", " ", "of", " ", "fitness", " ", "vs", " ", 
         "care"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"sdByCare", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Care (c)\>\"", 
             ",", "\"\<SD of fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<SD of fitness vs care (\>\"", "<>", "shape", 
            "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"meanByCare", ",", "sdByCare"}], "}"}]}]}], "]"}]}], ";"}], 
  "\n"}]], "Input",
 CellChangeTimes->{{3.978758218158032*^9, 3.9787582793942833`*^9}, {
  3.984459978132152*^9, 3.984460019339035*^9}},
