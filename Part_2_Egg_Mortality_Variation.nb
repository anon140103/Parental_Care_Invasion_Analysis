Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getLineData", "[", "g_", "]"}], ":=", 
   RowBox[{"First", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "g", "]"}], ",", 
      RowBox[{
       RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getPlotColour", "[", "g_", "]"}], ":=", 
    RowBox[{"First", "@", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "g", "]"}], ",", "_RGBColor", ",", "Infinity"}],
       "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"detData", "=", 
   RowBox[{"getLineData", "[", "plotSigmoid", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stochData", "=", 
    RowBox[{"getLineData", "[", "plotOverallMeanEggSig", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"detCol", "=", 
   RowBox[{"getPlotColour", "[", "plotSigmoid", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stochCol", "=", 
    RowBox[{"getPlotColour", "[", "plotOverallMeanEggSig", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sigmoidOneEntity", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"detData", ",", "stochData"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"detCol", ",", "Thick"}], "]"}], ",", 
