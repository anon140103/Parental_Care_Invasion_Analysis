Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getLineData", "[", "g_", "]"}], ":=", 
   RowBox[{"First", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "g", "]"}], ",", 
      RowBox[{
       RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getPlotColour", "[", "g_", "]"}], ":=", 
    RowBox[{"First", "@", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "g", "]"}], ",", "_RGBColor", ",", "Infinity"}],
       "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ValueQ", "[", "meanYRange", "]"}], "&&", 
      RowBox[{"MatchQ", "[", 
       RowBox[{"meanYRange", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"_", "?", "NumericQ"}], ",", 
          RowBox[{"_", "?", "NumericQ"}]}], "}"}]}], "]"}]}], ",", "Null", ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"And", "[", 
         RowBox[{
          RowBox[{"ValueQ", "[", "overallMeanRExp", "]"}], ",", 
          RowBox[{"ValueQ", "[", "overallMeanRSat", "]"}], ",", 
          RowBox[{"ValueQ", "[", "overallMeanRSig", "]"}], ",", 
          RowBox[{"ValueQ", "[", "fit1", "]"}], ",", 
          RowBox[{"ValueQ", "[", "fit2", "]"}], ",", 
          RowBox[{"ValueQ", "[", "fit3", "]"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"allMeanDetValues", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"overallMeanRExp", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"overallMeanRSat", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"overallMeanRSig", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"fit1", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"fit2", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"fit3", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"minMeanY", "=", 
          RowBox[{"Min", "[", "allMeanDetValues", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"maxMeanY", "=", 
          RowBox[{"Max", "[", "allMeanDetValues", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rangeMean", "=", 
          RowBox[{"maxMeanY", "-", "minMeanY"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"paddingMean", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"rangeMean", "==", "0"}], ",", "0.1", ",", 
            RowBox[{"0.05", "*", "rangeMean"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"meanYRange", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"minMeanY", "-", "paddingMean"}], ",", 
            RowBox[{"maxMeanY", "+", "paddingMean"}]}], "}"}]}], ";"}], ",", 
        RowBox[{
         RowBox[{"allMeanDetValues", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"getLineData", "[", "plotExp", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"getLineData", "[", "plotSaturating", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"getLineData", "[", "plotSigmoid", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"getLineData", "[", "plotOverallMeanEggExp", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"getLineData", "[", "plotOverallMeanEggSat", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"getLineData", "[", "plotOverallMeanEggSig", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"minMeanY", "=", 
          RowBox[{"Min", "[", "allMeanDetValues", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"maxMeanY", "=", 
          RowBox[{"Max", "[", "allMeanDetValues", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rangeMean", "=", 
          RowBox[{"maxMeanY", "-", "minMeanY"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"paddingMean", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"rangeMean", "==", "0"}], ",", "0.1", ",", 
            RowBox[{"0.05", "*", "rangeMean"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"meanYRange", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"minMeanY", "-", "paddingMean"}], ",", 
            RowBox[{"maxMeanY", "+", "paddingMean"}]}], "}"}]}], ";"}]}], 
       "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "Exponential", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
