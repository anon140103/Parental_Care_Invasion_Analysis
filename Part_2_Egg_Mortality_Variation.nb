   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"interpAt", "[", 
     RowBox[{"data_", ",", "x_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"SortBy", "[", 
        RowBox[{"data", ",", "First"}], "]"}], ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", "x", "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eggCrossStatsFromPlots", "[", 
     RowBox[{"meanG_", ",", "sdG_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "meanData", ",", "sdData", ",", "maxSDPt", ",", "cAtMaxSD", ",", 
        "sdMax", ",", "meanAtCmaxSD", ",", "pctSDofMeanAtMaxSD", ",", 
        "maxMeanPt", ",", "cAtMaxMean", ",", "meanMax", ",", "sdAtCmaxMean", ",",
         "pctSDofMeanAtMaxMean"}], "}"}], ",", 
      RowBox[{
       RowBox[{"meanData", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"extractXY", "[", "meanG", "]"}], ",", "First"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"sdData", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"extractXY", "[", "sdG", "]"}], ",", "First"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"maxSDPt", "=", 
        RowBox[{"First", "@", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"sdData", ",", "Last"}], "]"}]}]}], ";", 
       RowBox[{"cAtMaxSD", "=", 
        RowBox[{"maxSDPt", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdMax", "=", 
        RowBox[{"maxSDPt", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanAtCmaxSD", "=", 
        RowBox[{"interpAt", "[", 
         RowBox[{"meanData", ",", "cAtMaxSD"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pctSDofMeanAtMaxSD", "=", 
        RowBox[{"100", " ", 
         RowBox[{"sdMax", "/", "meanAtCmaxSD"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxMeanPt", "=", 
        RowBox[{"First", "@", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"meanData", ",", "Last"}], "]"}]}]}], ";", 
       RowBox[{"cAtMaxMean", "=", 
        RowBox[{"maxMeanPt", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanMax", "=", 
        RowBox[{"maxMeanPt", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdAtCmaxMean", "=", 
        RowBox[{"interpAt", "[", 
         RowBox[{"sdData", ",", "cAtMaxMean"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pctSDofMeanAtMaxMean", "=", 
        RowBox[{"100", " ", 
         RowBox[{"sdAtCmaxMean", "/", "meanMax"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<c at Max SD\>\"", "->", "cAtMaxSD"}], ",", 
         RowBox[{"\"\<Max SD(\[Lambda])\>\"", "->", "sdMax"}], ",", 
