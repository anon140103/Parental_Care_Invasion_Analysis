 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "getLineData", ",", "maxPointFromData", ",", "zeroCrossingsXNotOriginAll",
      ",", "firstZeroCrossingXNotOrigin", ",", "secondZeroCrossingXNotOrigin",
      ",", "diffRowForShape", ",", "formatNum", ",", "prettyResultsEgg", ",", 
