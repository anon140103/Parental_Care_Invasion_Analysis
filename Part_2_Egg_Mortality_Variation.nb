               RowBox[{"{", 
                RowBox[{"Infinity", ",", "3"}], "}"}]}], "]"}]}], "}"}], 
           "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"sdTickPos", ",", "sdTickVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Show", "[", 
        RowBox[{"meanPlot", ",", "sdScaledPlot", ",", 
         RowBox[{"ImageSize", "->", 
          RowBox[{"{", 
           RowBox[{"imgW", ",", "imgH"}], "}"}]}], ",", 
