Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getLineData", "[", "g_", "]"}], ":=", 
   RowBox[{"First", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "g", "]"}], ",", 
      RowBox[{
       RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"getPlotColour", "[", "g_", "]"}], ":=", 
    RowBox[{"First", "@", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "g", "]"}], ",", "_RGBColor", ",", "Infinity"}],
       "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"detData", "=", 
   RowBox[{"getLineData", "[", "plotExp", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stochData", "=", 
    RowBox[{"getLineData", "[", "plotOverallMeanEggExp", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"detCol", "=", 
   RowBox[{"getPlotColour", "[", "plotExp", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stochCol", "=", 
    RowBox[{"getPlotColour", "[", "plotOverallMeanEggExp", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expOneEntity", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"detData", ",", "stochData"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"detCol", ",", "Thick"}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"stochCol", ",", "Thick"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
