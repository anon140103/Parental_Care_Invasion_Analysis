               RowBox[{"-", "costNu"}], "*", "c"}], "]"}]}]}], ",", 
           RowBox[{"sigmaJ0b", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"sigmaJMax", "-", "sigmaJ0b"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"c", "/", 
               RowBox[{"(", 
                RowBox[{"Khalf", "+", "c"}], ")"}]}], ")"}]}]}]}], "}"}], "/.",
          " ", "params"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
