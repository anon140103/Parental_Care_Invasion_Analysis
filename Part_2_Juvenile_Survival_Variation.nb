   RowBox[{"SeedRandom", "[", "2100", "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sjVals", "=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"juvenileSurvivalDist", "[", 
       RowBox[{"meanSJ", ",", "20"}], "]"}], ",", "100"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"paramSets", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"baseParamsJuvenile", ",", 
        RowBox[{"{", 
         RowBox[{"\[Sigma]J0", "->", "sj"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"sj", ",", "sjVals"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitnessFixedC", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"getFitFixedC", "[", 
       RowBox[{
        RowBox[{"paramSets", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<Exp\>\""}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"resultsFixedC", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"sjVals", ",", "fitnessFixedC"}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"meanLambda", "=", 
   RowBox[{"Mean", "[", "fitnessFixedC", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sdLambda", "=", 
    RowBox[{"StandardDeviation", "[", "fitnessFixedC", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"distPlot", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"resultsFixedC", ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.121", ",", "0.467", ",", "0.705"}], "]"}], ",", 
         RowBox[{"PointSize", "[", "0.006", "]"}]}], "]"}]}], ",", 
      RowBox[{"Axes", "->", "True"}], ",", 
      RowBox[{"AxesOrigin", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Sigma]J\>\"", ",", "\"\<\[Lambda]\>\""}], "}"}]}], ",", 
      RowBox[{"TicksStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "12", ",", 
         RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], "]"}]}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "14", ",", 
         RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], "]"}]}], ",", 
      RowBox[{"PlotTheme", "->", "\"\<Classic\>\""}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"ImageSize", "->", "520"}], ",", 
      RowBox[{"ImagePadding", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"80", ",", "150"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"60", ",", "80"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"PlotRangeClipping", "->", "False"}], ",", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{"\"\<Mean(\[Lambda]) = \>\"", ",", 
                   RowBox[{"NumberForm", "[", 
                    RowBox[{"meanLambda", ",", 
                    RowBox[{"{", 
                    RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}], ",",
                 "18", ",", "Orange", ",", 
                RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
               "]"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{"\"\<SD(\[Lambda]) = \>\"", ",", 
                   RowBox[{"NumberForm", "[", 
                    RowBox[{"sdLambda", ",", 
                    RowBox[{"{", 
                    RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}], ",",
                 "18", ",", 
                RowBox[{"RGBColor", "[", 
                 RowBox[{"0", ",", "0.35", ",", "0"}], "]"}], ",", 
                RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
               "]"}]}], "}"}], ",", 
            RowBox[{"Spacings", "->", "0.4"}]}], "]"}], ",", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.85", ",", "0.7"}], "}"}], "]"}]}], "]"}], "}"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", "distPlot"}], "Input",
