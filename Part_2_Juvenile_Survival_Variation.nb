Cell[CellGroupData[{

Cell["Mean vs Deterministic Plots", "Title",
 CellChangeTimes->{{3.9805694753814507`*^9, 3.9805694825903263`*^9}, {
  3.980570577688888*^9, 
  3.980570582392639*^9}},ExpressionUUID->"b2b76899-fe20-438a-a0f5-\
52ce1b0cdf6b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getLineData", "[", "g_", "]"}], ":=", 
   RowBox[{"First", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "g", "]"}], ",", 
      RowBox[{
       RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"getPlotColour", "[", "g_", "]"}], ":=", 
   RowBox[{"First", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "g", "]"}], ",", "_RGBColor", ",", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ValueQ", "[", "meanYRange", "]"}], "&&", 
      RowBox[{"MatchQ", "[", 
       RowBox[{"meanYRange", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"_", "?", "NumericQ"}], ",", 
          RowBox[{"_", "?", "NumericQ"}]}], "}"}]}], "]"}]}], ",", "Null", ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"And", "[", 
         RowBox[{
          RowBox[{"ValueQ", "[", "overallMeanRExp", "]"}], ",", 
          RowBox[{"ValueQ", "[", "overallMeanRSat", "]"}], ",", 
          RowBox[{"ValueQ", "[", "overallMeanRSig", "]"}], ",", 
          RowBox[{"ValueQ", "[", "fit1", "]"}], ",", 
          RowBox[{"ValueQ", "[", "fit2", "]"}], ",", 
          RowBox[{"ValueQ", "[", "fit3", "]"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"allMeanDetValues", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"overallMeanRExp", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"overallMeanRSat", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"overallMeanRSig", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"fit1", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"fit2", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"fit3", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"minMeanY", "=", 
          RowBox[{"Min", "[", "allMeanDetValues", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"maxMeanY", "=", 
          RowBox[{"Max", "[", "allMeanDetValues", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rangeMean", "=", 
          RowBox[{"maxMeanY", "-", "minMeanY"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"paddingMean", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"rangeMean", "==", "0"}], ",", "0.1", ",", 
            RowBox[{"0.05", "*", "rangeMean"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"meanYRange", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"minMeanY", "-", "paddingMean"}], ",", 
            RowBox[{"maxMeanY", "+", "paddingMean"}]}], "}"}]}], ";"}], ",", 
        RowBox[{
         RowBox[{"allMeanDetValues", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"getLineData", "[", "plotExp", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"getLineData", "[", "plotSaturating", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"getLineData", "[", "plotSigmoid", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"getLineData", "[", "plotOverallMeanSJExp", "]"}], "[", 
              
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"getLineData", "[", "plotOverallMeanSJSat", "]"}], "[", 
              
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"getLineData", "[", "plotOverallMeanSJSig", "]"}], "[", 
              
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"minMeanY", "=", 
          RowBox[{"Min", "[", "allMeanDetValues", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"maxMeanY", "=", 
          RowBox[{"Max", "[", "allMeanDetValues", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rangeMean", "=", 
          RowBox[{"maxMeanY", "-", "minMeanY"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"paddingMean", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"rangeMean", "==", "0"}], ",", "0.1", ",", 
            RowBox[{"0.05", "*", "rangeMean"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"meanYRange", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"minMeanY", "-", "paddingMean"}], ",", 
            RowBox[{"maxMeanY", "+", "paddingMean"}]}], "}"}]}], ";"}]}], 
       "]"}], ";"}]}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Exponential", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"detData", "=", 
