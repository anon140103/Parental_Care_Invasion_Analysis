               RowBox[{"-", "a"}], "*", "c"}], "]"}]}]}]}], "}"}], "/.", " ", 
         "params"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
