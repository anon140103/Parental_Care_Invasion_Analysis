     RowBox[{"no", " ", "care"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"muStar", "[", "params_", "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{"\[Theta]", "/.", " ", "params"}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rStar", "[", "params_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"s", "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Theta]"}], ")"}]}], "]"}]}], ")"}], "/.", " ",
       "params"}]}], ";"}], "\n", 
   RowBox[{
