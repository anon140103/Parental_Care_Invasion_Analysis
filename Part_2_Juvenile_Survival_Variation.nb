Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extractXY", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "d", "}"}], ",", 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "g", "]"}], ",", 
          RowBox[{
           RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", 
          "Infinity"}], "]"}]}], ";", 
       RowBox[{"First", "[", "d", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"maxYFromPlot", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xy", "=", 
        RowBox[{"extractXY", "[", "g", "]"}]}], "}"}], ",", 
      RowBox[{"Max", "[", 
       RowBox[{"xy", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fmt4", "[", "x_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"NumericQ", "[", "x", "]"}], ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"N", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Infinity", ",", "4"}], "}"}]}], "]"}], ",", "x"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sjMaxStats", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"shapes", ",", "meanPlots", ",", "sdPlots", ",", "rows"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"shapes", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<Exponential\>\"", ",", "\"\<Saturating\>\"", 
          ",", "\"\<Sigmoid\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanPlots", "=", 
        RowBox[{"{", 
         RowBox[{
         "plotOverallMeanSJExp", ",", "plotOverallMeanSJSat", ",", 
          "plotOverallMeanSJSig"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdPlots", "=", 
        RowBox[{"{", 
         RowBox[{
         "plotOverallSDSJExp", ",", "plotOverallSDSJSat", ",", 
          "plotOverallSDSJSig"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"shape", ",", "meanG", ",", "sdG"}], "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"maxMean", ",", "maxSD", ",", "pct"}], "}"}], ",", 
              RowBox[{
               RowBox[{"maxMean", "=", 
                RowBox[{"maxYFromPlot", "[", "meanG", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"maxSD", "=", 
                RowBox[{"maxYFromPlot", "[", "sdG", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"pct", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"maxMean", "==", "0"}], ",", 
                  RowBox[{"Missing", "[", "\"\<Undefined\>\"", "]"}], ",", 
                  RowBox[{"100", " ", 
                   RowBox[{"maxSD", "/", "maxMean"}]}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"shape", ",", "maxSD", ",", "maxMean", ",", "pct"}], 
                "}"}]}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"shapes", ",", "meanPlots", ",", "sdPlots"}], "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"rows", "/.", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"s_", ",", "sd_", ",", "mn_", ",", "pc_"}], "}"}], ":>", 
              RowBox[{"{", 
               RowBox[{"s", ",", 
                RowBox[{"fmt4", "[", "sd", "]"}], ",", 
                RowBox[{"fmt4", "[", "mn", "]"}], ",", 
                RowBox[{"fmt4", "[", "pc", "]"}]}], "}"}]}]}], ")"}], ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Trade-off shape\>\"", 
             ",", "\"\<Max SD(\[Lambda])\>\"", 
             ",", "\"\<Max Mean \[Lambda]\>\"", 
             ",", "\"\<Max SD as % of Max Mean\>\""}], "}"}]}], "]"}], ",", 
         RowBox[{"Frame", "->", "All"}], ",", 
         RowBox[{"Alignment", "->", "Center"}], ",", 
         RowBox[{"Background", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Lighter", "[", 
               RowBox[{"Gray", ",", "0.95"}], "]"}], ",", 
              RowBox[{"{", "White", "}"}]}], "}"}]}], "}"}]}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", "sjMaxStats"}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
