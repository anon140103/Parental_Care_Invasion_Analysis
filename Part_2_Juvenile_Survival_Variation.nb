    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Mu]res", ",", "rres", ",", "\[Nu]res", ",", "\[Sigma]Jres", ",", 
        "\[Mu]mut", ",", "rmut", ",", "\[Nu]mut", ",", "\[Sigma]Jmut", ",", 
        "A", ",", "mat", ",", "res", ",", "V"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"resident", ":", 
        RowBox[{"no", " ", "care"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[Mu]res", ",", "rres", ",", "\[Nu]res", ",", "\[Sigma]Jres"}], 
         "}"}], "=", 
        RowBox[{
         RowBox[{"tradeOff", "[", "shape", "]"}], "[", 
         RowBox[{"params", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"mutant", ":", 
          RowBox[{"fixed", " ", "care", " ", "c"}]}], "=", "0.5"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[Mu]mut", ",", "rmut", ",", "\[Nu]mut", ",", "\[Sigma]Jmut"}], 
         "}"}], "=", 
        RowBox[{
         RowBox[{"tradeOff", "[", "shape", "]"}], "[", 
         RowBox[{"params", ",", "0.5"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"(*", 
        RowBox[{"resident", " ", "equilibrium"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"K", "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"\[Nu]res", "/", "\[Sigma]Jres"}], ")"}], "*", 
                  RowBox[{"(", 
                   RowBox[{"1", "+", 
                    RowBox[{"(", 
                    RowBox[{"\[Mu]res", "/", "mE"}], ")"}]}], ")"}]}], ")"}], 
                "/", "rres"}], ")"}]}], ")"}]}], ")"}], "/.", " ", "params"}],
          "//", "N"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"invasion", " ", "Jacobian"}], "*)"}], "\[IndentingNewLine]", 
       
       RowBox[{"mat", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "\[Lambda]"}], "-", "mE", "-", "\[Mu]mut"}], ",", 
             RowBox[{"rmut", "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"A", "/", "K"}]}], ")"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"mE", "*", "\[Sigma]Jmut"}], ",", 
             RowBox[{
              RowBox[{"-", "\[Lambda]"}], "-", "\[Nu]mut"}]}], "}"}]}], "}"}],
          "/.", " ", "params"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"dominant", " ", "eigenvalue"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"res", "=", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Det", "[", "mat", "]"}], "==", "0"}], ",", "\[Lambda]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"V", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Lambda]", "/.", " ", 
             RowBox[{"res", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/.", " ", "params"}], 
          "//", "N"}], "//", "Re"}]}], ";", "\[IndentingNewLine]", "V"}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
