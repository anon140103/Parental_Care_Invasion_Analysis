   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Exponential", " ", "trade"}], "-", "off"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"tradeOff", "[", "\"\<Exp\>\"", "]"}], "[", 
