Cell[CellGroupData[{

Cell["Deterministic Shape", "Title",
 CellChangeTimes->{{3.9804814145005293`*^9, 
  3.980481423975975*^9}},ExpressionUUID->"34a30ffc-b23e-4b4b-befe-\
e51df4a0c398"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Aexpr", "[", 
      RowBox[{"th_", ",", "v0_", ",", "sj_", ",", "ss_", ",", "me_", ",", 
       RowBox[{"Kval_", ":", "250"}]}], "]"}], ":=", 
     RowBox[{"Kval", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"v0", "/", "sj"}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"(", 
               RowBox[{"th", "/", "me"}], ")"}]}], ")"}]}], ")"}], "/", 
          "ss"}], ")"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Care", " ", "mutant", " ", "invading", " ", "no"}], "-", 
     RowBox[{"care", " ", "resident"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getFit", "[", 
      RowBox[{"params_", ",", 
       RowBox[{"shape_String", ":", "\"\<Exp\>\""}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Mu]res", ",", "rres", ",", "\[Nu]res", ",", "\[Sigma]Jres", ",", 
         "\[Mu]mut", ",", "rmut", ",", "\[Nu]mut", ",", "\[Sigma]Jmut", ",", 
         "A", ",", "mat", ",", "res", ",", "V"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Mu]res", ",", "rres", ",", "\[Nu]res", ",", "\[Sigma]Jres"}], 
          "}"}], "=", 
         RowBox[{
          RowBox[{"tradeOff", "[", "shape", "]"}], "[", 
          RowBox[{"params", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Mu]mut", ",", "rmut", ",", "\[Nu]mut", ",", "\[Sigma]Jmut"}], 
          "}"}], "=", 
         RowBox[{
          RowBox[{"tradeOff", "[", "shape", "]"}], "[", 
          RowBox[{"params", ",", "c"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"A", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"K", "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"\[Nu]res", "/", "\[Sigma]Jres"}], ")"}], "*", 
                   RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"(", 
                    RowBox[{"\[Mu]res", "/", "mE"}], ")"}]}], ")"}]}], ")"}], 
                 "/", "rres"}], ")"}]}], ")"}]}], ")"}], "/.", " ", 
           "params"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mat", "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Lambda]"}], "-", "mE", "-", "\[Mu]mut"}], ",", 
              
              RowBox[{"rmut", "*", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"A", "/", "K"}]}], ")"}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"mE", "*", "\[Sigma]Jmut"}], ",", 
              RowBox[{
               RowBox[{"-", "\[Lambda]"}], "-", "\[Nu]mut"}]}], "}"}]}], 
           "}"}], "/.", " ", "params"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Det", "[", "mat", "]"}], "==", "0"}], ",", "\[Lambda]"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"V", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Lambda]", "/.", " ", 
             RowBox[{"res", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/.", " ", "params"}], 
          "//", "Simplify"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"val", ",", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", 
              RowBox[{"V", "/.", " ", 
               RowBox[{"c", "->", "val"}]}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"val", ",", "0", ",", "2", ",", "0.01"}], "}"}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"params1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Theta]", "->", "0.8"}], ",", 
       RowBox[{"\[Nu]0", "->", "0.1"}], ",", 
       RowBox[{"\[Sigma]J0", "->", "0.32383733876731385"}], ",", 
       RowBox[{"s", "->", "6"}], ",", 
       RowBox[{"mE", "->", "0.2"}], ",", 
       RowBox[{"K", "->", "250"}], ",", 
       RowBox[{"a", "->", "6"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"params2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Theta]", "->", "0.7999967491603689"}], ",", 
       RowBox[{"\[Nu]0", "->", "0.10000440803427434"}], ",", 
       RowBox[{"\[Sigma]J0", "->", "0.32383733876731385"}], ",", 
       RowBox[{"s", "->", "5.999984154933559"}], ",", 
       RowBox[{"mE", "->", "0.19999923208705223"}], ",", 
       RowBox[{"K", "->", "250"}], ",", 
