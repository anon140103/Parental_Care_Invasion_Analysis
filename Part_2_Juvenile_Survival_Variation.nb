       "\[IndentingNewLine]", 
       RowBox[{"sdMin", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"sdData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sdMax", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"sdData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanPad", "=", 
        RowBox[{"0.05", "*", 
         RowBox[{"(", 
          RowBox[{"meanMax", "-", "meanMin"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"meanPad", "==", "0"}], ",", 
         RowBox[{"meanPad", "=", "0.1"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdPad", "=", 
        RowBox[{"0.05", "*", 
         RowBox[{"(", 
          RowBox[{"sdMax", "-", "sdMin"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sdPad", "==", "0"}], ",", 
