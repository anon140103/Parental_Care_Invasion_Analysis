   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"tradeOff", "[", "\"\<Saturating\>\"", "]"}], "[", 
      RowBox[{"params_", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mu0", ",", "r0", ",", "nu0b", ",", "sigmaJ0b", ",", 
