Cell[BoxData[{
 RowBox[{
  RowBox[{"imgW", "=", "520"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"imgH", "=", "300"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanStyle", "=", 
   RowBox[{"Directive", "[", 
    RowBox[{"Orange", ",", "Thick"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sdStyle", "=", 
   RowBox[{"Directive", "[", 
    RowBox[{
     RowBox[{"RGBColor", "[", 
      RowBox[{"0", ",", "0.35", ",", "0"}], "]"}], ",", "Thick"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"extractXY", "[", "g_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "d", "}"}], ",", 
     RowBox[{
      RowBox[{"d", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"Normal", "[", "g", "]"}], ",", 
         RowBox[{
          RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", 
         "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"First", "[", "d", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeMeanSDOverlayFromPlots", "[", 
     RowBox[{"meanG_", ",", "sdG_", ",", "title_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "meanData", ",", "sdData", ",", "xMin", ",", "xMax", ",", "meanMin", ",",
         "meanMax", ",", "sdMin", ",", "sdMax", ",", "meanPad", ",", "sdPad", 
        ",", "meanPR", ",", "sdPR", ",", "scale", ",", "meanPlot", ",", 
        "sdScaledPlot", ",", "sdTickVals", ",", "sdTickPos", ",", 
