          RowBox[{"0", ",", "2"}], "}"}], ",", "meanYRange"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<c\>\"", ",", "\"\<\[Lambda]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<Exponential\>\"", ",", "16", ",", "Bold", ",", 
             "Underlined"}], "]"}], ",", 
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Directive", "[", 
                RowBox[{"detCol", ",", "Thick"}], "]"}], ",", 
               RowBox[{"Directive", "[", 
                RowBox[{"stochCol", ",", "Thick"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Deterministic\>\"", ",", "\"\<Stochastic\>\""}], 
              "}"}], ",", 
             RowBox[{"LegendLayout", "->", "\"\<Row\>\""}]}], "]"}]}], "}"}], 
         ",", "Center", ",", 
         RowBox[{"Spacings", "->", "0.6"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", "Saturating", "*)"}]}], "\n", 
