        RowBox[{"sigmaJ0b", "=", 
         RowBox[{"sigmaJStar", "[", "params", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"L", "[", "x_", "]"}], ":=", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "k"}], "*", 
              RowBox[{"(", 
               RowBox[{"x", "-", "c0"}], ")"}]}], "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"L0", "=", 
         RowBox[{"L", "[", "0", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Lnorm", "[", "x_", "]"}], ":=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"L", "[", "x", "]"}], "-", "L0"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", "L0"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"mu0", "*", 
            RowBox[{"(", 
