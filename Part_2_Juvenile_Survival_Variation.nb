        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"mu0", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "a"}], "*", "c"}], "]"}]}], ",", 
           RowBox[{"r0", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{"-", "c"}], "]"}]}], ",", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "nu0b"}], ")"}], "*", 
