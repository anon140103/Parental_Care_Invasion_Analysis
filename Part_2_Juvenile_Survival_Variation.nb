            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "nu0b"}], ")"}], "*", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "costNu"}], "*", "c"}], "]"}]}]}], ",", 
           RowBox[{"sigmaJ0b", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"sigmaJMax", "-", "sigmaJ0b"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"c", "/", 
               RowBox[{"(", 
                RowBox[{"Khalf", "+", "c"}], ")"}]}], ")"}]}]}]}], "}"}], "/.",
          " ", "params"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
