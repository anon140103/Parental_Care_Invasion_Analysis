Cell[CellGroupData[{

Cell["Big Function", "Subtitle",
 CellChangeTimes->{{3.9787578398374977`*^9, 
  3.978757844041884*^9}},ExpressionUUID->"629ff6db-3ff3-4922-8c38-\
3bda67db8c73"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runJuvenileSurvivalCase", "[", 
     RowBox[{"kappa_", ",", "n_", ",", "seed_", ",", 
      RowBox[{"shape_String", ":", "\"\<Exp\>\""}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sjVals", ",", 
        RowBox[{"(*", 
         RowBox[{"sampled", " ", "juvenile", " ", "survival", " ", "values"}],
          "*)"}], "\[IndentingNewLine]", "paramSets", ",", 
        RowBox[{"(*", 
         RowBox[{
         "full", " ", "parameter", " ", "sets", " ", "with", " ", "different",
           " ", "juvenile", " ", "survival"}], "*)"}], "\[IndentingNewLine]", 
        "fitnessFixedC", ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "invasion", " ", "fitness", " ", "at", " ", "fixed", " ", "care", " ",
            "c"}], "=", "0.5"}], "*)"}], "\[IndentingNewLine]", 
        "resultsFixedC", ",", 
        RowBox[{"(*", 
         RowBox[{"paired", " ", 
          RowBox[{"(", 
           RowBox[{"juvenile", " ", "survival", " ", "x", " ", "fitness"}], 
           ")"}], " ", "values"}], "*)"}], "\[IndentingNewLine]", 
        "fitnessByCare", ",", 
        RowBox[{"(*", 
         RowBox[{"invasion", " ", "fitness", " ", "across", " ", "care"}], 
         "*)"}], "\[IndentingNewLine]", "meanByCare", ",", 
        RowBox[{"(*", 
         RowBox[{"mean", " ", "fitness", " ", "across", " ", "care"}], "*)"}],
         "\[IndentingNewLine]", "sdByCare"}], "          ", 
       RowBox[{"(*", 
        RowBox[{"standard", " ", "deviation", " ", "across", " ", "care"}], 
        "*)"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"fix", " ", "the", " ", "seed"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "draw", " ", "n", " ", "juvenile", " ", "survival", " ", "values"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"sjVals", "=", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"juvenileSurvivalDist", "[", 
           RowBox[{"meanSJ", ",", "kappa"}], "]"}], ",", "n"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "plot", " ", "the", " ", "sampled", " ", "juvenile", " ", "survival", 
         " ", "distribution"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"Histogram", "[", 
         RowBox[{"sjVals", ",", "20", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Juvenile survival (\[Sigma]J0)\>\"", 
             ",", "\"\<Frequency\>\""}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Juvenile survival distribution (\>\"", "<>", "shape", 
            "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "build", " ", "full", " ", "parameter", " ", "sets", " ", "by", " ", 
         "replacing", " ", "juvenile", " ", "survival"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"paramSets", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"baseParamsJuvenile", ",", 
            RowBox[{"{", 
             RowBox[{"\[Sigma]J0", "->", "sj"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"sj", ",", "sjVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "caluclate", " ", "invasion", " ", "fitness", " ", "at", " ", "fixed",
          " ", "care"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitnessFixedC", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"getFitFixedC", "[", 
           RowBox[{
            RowBox[{"paramSets", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "shape"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "pair", " ", "juvenile", " ", "survival", " ", "values", " ", "with", 
         " ", "fitness"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"resultsFixedC", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"sjVals", ",", "fitnessFixedC"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "plot", " ", "fitness", " ", "vs", " ", "juvenile", " ", "survival", 
          " ", "at", " ", "c"}], "=", "0.5"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"resultsFixedC", ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Juvenile survival (\[Sigma]J0)\>\"", 
             ",", "\"\<Fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Fitness vs juvenile survival (\>\"", "<>", "shape", 
            "<>", "\"\<, c = 0.5, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "do", " ", "invasion", " ", "fitness", " ", "across", " ", "care"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fitnessByCare", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"getFitAtC", "[", 
               RowBox[{
                RowBox[{"paramSets", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", "c", ",", "shape"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}],
            "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c", ",", "careVals"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "calculate", " ", "mean", " ", "fitness", " ", "across", " ", 
         "care"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"meanByCare", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"Mean", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "fitnessByCare"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"SD", " ", "of", " ", "fitness", " ", "across", " ", "care"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"sdByCare", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "fitnessByCare"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"plot", " ", "mean", " ", "fitness", " ", "vs", " ", "care"}],
         "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"meanByCare", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<Care (c)\>\"", 
             ",", "\"\<Mean fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<Mean fitness vs care (\>\"", "<>", "shape", 
            "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "plot", " ", "SD", " ", "of", " ", "fitness", " ", "vs", " ", 
         "care"}], "*)"}], 
       RowBox[{"Print", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"sdByCare", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Care (c)\>\"", 
             ",", "\"\<SD of fitness (\[Lambda])\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           
           RowBox[{"\"\<SD of fitness vs care (\>\"", "<>", "shape", 
            "<>", "\"\<, \[Kappa] = \>\"", "<>", 
            RowBox[{"ToString", "[", "kappa", "]"}], "<>", "\"\<, n = \>\"", "<>", 
            RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"meanByCare", ",", "sdByCare"}], "}"}]}]}], "]"}]}], ";"}], 
  "\n"}]], "Input",
