Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getLineData", "[", "g_", "]"}], ":=", 
     RowBox[{"First", "@", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Normal", "[", "g", "]"}], ",", 
        RowBox[{
         RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}],
        "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"maxPointFromData", "[", "data_", "]"}], ":=", 
     RowBox[{"First", "@", 
      RowBox[{"MaximalBy", "[", 
       RowBox[{"data", ",", "Last"}], "]"}]}]}], ";"}], "\[IndentingNewLine]",
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"zeroCrossingsXNotOriginAll", "[", 
      RowBox[{"data_", ",", 
       RowBox[{"tol_", ":", 
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pts", "=", 
          RowBox[{"SortBy", "[", 
           RowBox[{"data", ",", "First"}], "]"}]}], ",", "segs", ",", 
         "roots"}], "}"}], ",", 
       RowBox[{
        RowBox[{"segs", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"pts", ",", "2", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"roots", "=", 
         RowBox[{
          RowBox[{"Reap", "[", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"x1", "=", 
                  RowBox[{"seg", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
                 RowBox[{"y1", "=", 
                  RowBox[{"seg", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
                 RowBox[{"x2", "=", 
                  RowBox[{"seg", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", 
                 RowBox[{"y2", "=", 
                  RowBox[{"seg", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", "y1", "]"}], "<=", "tol"}], "&&", 
                   RowBox[{
                    RowBox[{"Abs", "[", "x1", "]"}], ">", "tol"}]}], ",", 
                  RowBox[{"Sow", "[", "x1", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", "y2", "]"}], "<=", "tol"}], "&&", 
                   RowBox[{
                    RowBox[{"Abs", "[", "x2", "]"}], ">", "tol"}]}], ",", 
                  RowBox[{"Sow", "[", "x2", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"y1", "*", "y2"}], "<", "0"}], ",", 
                  RowBox[{"With", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x0", "=", 
                    RowBox[{"x1", "-", 
                    RowBox[{"y1", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"x2", "-", "x1"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"y2", "-", "y1"}], ")"}]}]}]}]}], "}"}], ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "x0", "]"}], ">", "tol"}], ",", 
                    RowBox[{"Sow", "[", "x0", "]"}]}], "]"}]}], "]"}]}], 
                 "]"}], ";"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"seg", ",", "segs"}], "}"}]}], "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"roots", "===", 
            RowBox[{"{", "}"}]}], "||", 
           RowBox[{"roots", "===", 
            RowBox[{"{", 
             RowBox[{"{", "}"}], "}"}]}]}], ",", 
          RowBox[{"{", "}"}], ",", 
          RowBox[{
           RowBox[{"roots", "=", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{
              RowBox[{"First", "@", "roots"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "6"}]}]}], "&"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Sort", "@", 
            RowBox[{"Select", "[", 
             RowBox[{"roots", ",", 
              RowBox[{
               RowBox[{"#", ">", "tol"}], "&"}]}], "]"}]}]}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"firstZeroCrossingXNotOrigin", "[", 
      RowBox[{"data_", ",", 
       RowBox[{"tol_", ":", 
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xs", "=", 
         RowBox[{"zeroCrossingsXNotOriginAll", "[", 
          RowBox[{"data", ",", "tol"}], "]"}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"xs", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Missing", "[", "\"\<NoPositiveZeroCrossing\>\"", "]"}], ",", 
         RowBox[{"xs", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"secondZeroCrossingXNotOrigin", "[", 
      RowBox[{"data_", ",", 
       RowBox[{"tol_", ":", 
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xs", "=", 
         RowBox[{"zeroCrossingsXNotOriginAll", "[", 
          RowBox[{"data", ",", "tol"}], "]"}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "xs", "]"}], "<", "2"}], ",", 
         RowBox[{"Missing", "[", "\"\<NoSecondZeroCrossing\>\"", "]"}], ",", 
         RowBox[{"xs", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"detExpData", "=", 
     RowBox[{"getLineData", "[", "plotExp", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stochExpData", "=", 
     RowBox[{"getLineData", "[", "plotOverallMeanSJExp", "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"detSatData", "=", 
     RowBox[{"getLineData", "[", "plotSaturating", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stochSatData", "=", 
     RowBox[{"getLineData", "[", "plotOverallMeanSJSat", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"detSigData", "=", 
     RowBox[{"getLineData", "[", "plotSigmoid", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stochSigData", "=", 
     RowBox[{"getLineData", "[", "plotOverallMeanSJSig", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"resultsSJ", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Exponential\>\"", ",", "\"\<Deterministic\>\"", ",", 
         RowBox[{"maxPointFromData", "[", "detExpData", "]"}], ",", 
         RowBox[{"firstZeroCrossingXNotOrigin", "[", "detExpData", "]"}], ",", 
         RowBox[{"secondZeroCrossingXNotOrigin", "[", "detExpData", "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Exponential\>\"", ",", "\"\<Stochastic\>\"", ",", 
         RowBox[{"maxPointFromData", "[", "stochExpData", "]"}], ",", 
         RowBox[{"firstZeroCrossingXNotOrigin", "[", "stochExpData", "]"}], ",", 
         RowBox[{"secondZeroCrossingXNotOrigin", "[", "stochExpData", "]"}]}],
         "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Saturating\>\"", ",", "\"\<Deterministic\>\"", ",", 
         RowBox[{"maxPointFromData", "[", "detSatData", "]"}], ",", 
         RowBox[{"firstZeroCrossingXNotOrigin", "[", "detSatData", "]"}], ",", 
         RowBox[{"secondZeroCrossingXNotOrigin", "[", "detSatData", "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Saturating\>\"", ",", "\"\<Stochastic\>\"", ",", 
         RowBox[{"maxPointFromData", "[", "stochSatData", "]"}], ",", 
         RowBox[{"firstZeroCrossingXNotOrigin", "[", "stochSatData", "]"}], ",", 
         RowBox[{"secondZeroCrossingXNotOrigin", "[", "stochSatData", "]"}]}],
         "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Sigmoid\>\"", ",", "\"\<Deterministic\>\"", ",", 
         RowBox[{"maxPointFromData", "[", "detSigData", "]"}], ",", 
         RowBox[{"firstZeroCrossingXNotOrigin", "[", "detSigData", "]"}], ",", 
         RowBox[{"secondZeroCrossingXNotOrigin", "[", "detSigData", "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Sigmoid\>\"", ",", "\"\<Stochastic\>\"", ",", 
         RowBox[{"maxPointFromData", "[", "stochSigData", "]"}], ",", 
         RowBox[{"firstZeroCrossingXNotOrigin", "[", "stochSigData", "]"}], ",", 
         RowBox[{"secondZeroCrossingXNotOrigin", "[", "stochSigData", "]"}]}],
         "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"diffRowForShape", "[", "shape_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"det", ",", "stoch"}], "}"}], ",", 
       RowBox[{
        RowBox[{"det", "=", 
         RowBox[{"SelectFirst", "[", 
          RowBox[{"resultsSJ", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "==", "shape"}], "&&", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], 
              "==", "\"\<Deterministic\>\""}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stoch", "=", 
         RowBox[{"SelectFirst", "[", 
          RowBox[{"resultsSJ", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "==", "shape"}], "&&", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "==", "\"\<Stochastic\>\""}]}],
             "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"shape", ",", "\"\<Stoch-Det\>\"", ",", 
          RowBox[{
           RowBox[{"stoch", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "-", 
           RowBox[{"det", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"stoch", "[", 
            RowBox[{"[", "4", "]"}], "]"}], "-", 
           RowBox[{"det", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"stoch", "[", 
            RowBox[{"[", "5", "]"}], "]"}], "-", 
           RowBox[{"det", "[", 
            RowBox[{"[", "5", "]"}], "]"}]}]}], "                  ", 
         "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resultsSJ", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"resultsSJ", ",", 
       RowBox[{"diffRowForShape", "/@", 
        RowBox[{"{", 
         RowBox[{"\"\<Exponential\>\"", ",", "\"\<Saturating\>\"", 
          ",", "\"\<Sigmoid\>\""}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"resultsSJ", "//", 
     RowBox[{"TableForm", "[", 
      RowBox[{"TableHeadings", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Shape\>\"", ",", "\"\<Curve\>\"", 
           ",", "\"\<Max (x,y)\>\"", ",", "\"\<1st x where y=0 (x!=0)\>\"", 
           ",", "\"\<2nd x where y=0 (x!=0)\>\""}], "}"}]}], "}"}]}], "]"}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"formatNum", "[", "x_", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"NumericQ", "[", "x", "]"}], ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"x", ",", 
         RowBox[{"{", 
          RowBox[{"Infinity", ",", "4"}], "}"}]}], "]"}], ",", "x"}], "]"}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prettyResultsSJ", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "data", "}"}], ",", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"resultsSJ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"shape_", ",", "curve_", ",", 
              RowBox[{"{", 
               RowBox[{"x_", ",", "y_"}], "}"}], ",", "x01_", ",", "x02_"}], 
             "}"}], ":>", 
            RowBox[{"{", 
             RowBox[{"shape", ",", "curve", ",", 
              RowBox[{"formatNum", "[", "x", "]"}], ",", 
              RowBox[{"formatNum", "[", "y", "]"}], ",", 
              RowBox[{"formatNum", "[", "x01", "]"}], ",", 
              RowBox[{"formatNum", "[", "x02", "]"}]}], "}"}]}], "}"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Grid", "[", 
         RowBox[{
          RowBox[{"Prepend", "[", 
           RowBox[{"data", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Shape\>\"", ",", "\"\<Curve\>\"", 
              ",", "\"\<Optimal Level of Care\>\"", 
              ",", "\"\<Max \[Lambda]\>\"", ",", "\"\<1st Crossing (Care)\>\"",
               ",", "\"\<2nd Crossing (Care)\>\""}], "}"}]}], "]"}], ",", 
          RowBox[{"Frame", "->", "All"}], ",", 
          RowBox[{"Background", "->", 
           RowBox[{"{", 
            RowBox[{"None", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Lighter", "[", 
                RowBox[{"Gray", ",", "0.95"}], "]"}], ",", 
               RowBox[{"{", "White", "}"}]}], "}"}]}], "}"}]}], ",", 
          RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", "prettyResultsSJ"}]}]], "Input",
