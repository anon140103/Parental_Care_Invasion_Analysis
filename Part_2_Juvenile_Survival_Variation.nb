          RowBox[{"0", ",", "2"}], "}"}], ",", "meanYRange"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<c\>\"", ",", "\"\<\[Lambda]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Column", "[", 
        RowBox[{
