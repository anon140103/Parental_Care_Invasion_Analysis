         RowBox[{"sigmaJStar", "[", "params", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"mu0", "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
