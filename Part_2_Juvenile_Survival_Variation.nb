        "\[IndentingNewLine]", 
        RowBox[{"maxMeanY", "=", 
         RowBox[{"Max", "[", "allMeanDetValues", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rangeMean", "=", 
         RowBox[{"maxMeanY", "-", "minMeanY"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"paddingMean", "=", 
         RowBox[{"If", "[", 
