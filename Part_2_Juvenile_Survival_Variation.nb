957b6db12195"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "2100", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sjVals", "=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"juvenileSurvivalDist", "[", 
       RowBox[{"meanSJ", ",", "20"}], "]"}], ",", "100"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"paramSets", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"baseParamsJuvenile", ",", 
        RowBox[{"{", 
         RowBox[{"\[Sigma]J0", "->", "sj"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"sj", ",", "sjVals"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fitnessFixedC", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"getFitFixedC", "[", 
       RowBox[{
        RowBox[{"paramSets", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<Exp\>\""}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "paramSets", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"resultsFixedC", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"sjVals", ",", "fitnessFixedC"}], "}"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanLambda", "=", 
   RowBox[{"Mean", "[", "fitnessFixedC", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sdLambda", "=", 
    RowBox[{"StandardDeviation", "[", "fitnessFixedC", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"distPlot", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"resultsFixedC", ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
