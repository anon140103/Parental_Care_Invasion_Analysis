       RowBox[{"meanPR", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"meanMin", "-", "meanPad"}], ",", 
          RowBox[{"meanMax", "+", "meanPad"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sdPR", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"sdMax", "+", "sdPad"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
