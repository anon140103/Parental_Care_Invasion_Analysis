Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extractXY", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "d", "}"}], ",", 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "g", "]"}], ",", 
          RowBox[{
           RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", 
          "Infinity"}], "]"}]}], ";", 
       RowBox[{"First", "[", "d", "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fmt4", "[", "x_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"NumericQ", "[", "x", "]"}], ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"N", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Infinity", ",", "4"}], "}"}]}], "]"}], ",", "x"}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"interpAt", "[", 
     RowBox[{"data_", ",", "x_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "f", "}"}], ",", 
      RowBox[{
       RowBox[{"f", "=", 
        RowBox[{"Interpolation", "[", 
         RowBox[{
          RowBox[{"SortBy", "[", 
           RowBox[{"data", ",", "First"}], "]"}], ",", 
          RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"f", "[", "x", "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sjCrossStatsFromPlots", "[", 
     RowBox[{"meanG_", ",", "sdG_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "meanData", ",", "sdData", ",", "maxSDPt", ",", "cAtMaxSD", ",", 
        "sdMax", ",", "meanAtCmaxSD", ",", "pctSDofMeanAtMaxSD", ",", 
        "maxMeanPt", ",", "cAtMaxMean", ",", "meanMax", ",", "sdAtCmaxMean", ",",
         "pctSDofMeanAtMaxMean"}], "}"}], ",", 
      RowBox[{
       RowBox[{"meanData", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"extractXY", "[", "meanG", "]"}], ",", "First"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"sdData", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"extractXY", "[", "sdG", "]"}], ",", "First"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"maxSDPt", "=", 
        RowBox[{"First", "@", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"sdData", ",", "Last"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cAtMaxSD", "=", 
        RowBox[{"maxSDPt", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdMax", "=", 
        RowBox[{"maxSDPt", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanAtCmaxSD", "=", 
        RowBox[{"interpAt", "[", 
         RowBox[{"meanData", ",", "cAtMaxSD"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pctSDofMeanAtMaxSD", "=", 
        RowBox[{"100", " ", 
         RowBox[{"sdMax", "/", "meanAtCmaxSD"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxMeanPt", "=", 
        RowBox[{"First", "@", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"meanData", ",", "Last"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cAtMaxMean", "=", 
        RowBox[{"maxMeanPt", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanMax", "=", 
        RowBox[{"maxMeanPt", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdAtCmaxMean", "=", 
        RowBox[{"interpAt", "[", 
         RowBox[{"sdData", ",", "cAtMaxMean"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pctSDofMeanAtMaxMean", "=", 
        RowBox[{"100", " ", 
         RowBox[{"sdAtCmaxMean", "/", "meanMax"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
        "cAtMaxSD", ",", "sdMax", ",", "meanAtCmaxSD", ",", 
         "pctSDofMeanAtMaxSD", ",", "cAtMaxMean", ",", "meanMax", ",", 
