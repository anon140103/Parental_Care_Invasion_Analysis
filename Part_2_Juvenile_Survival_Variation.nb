 RowBox[{
  RowBox[{
   RowBox[{"sjMaxStats", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"shapes", ",", "meanPlots", ",", "sdPlots", ",", "rows"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"shapes", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<Exponential\>\"", ",", "\"\<Saturating\>\"", 
          ",", "\"\<Sigmoid\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"meanPlots", "=", 
        RowBox[{"{", 
         RowBox[{
         "plotOverallMeanSJExp", ",", "plotOverallMeanSJSat", ",", 
          "plotOverallMeanSJSig"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sdPlots", "=", 
        RowBox[{"{", 
         RowBox[{
         "plotOverallSDSJExp", ",", "plotOverallSDSJSat", ",", 
          "plotOverallSDSJSig"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"shape", ",", "meanG", ",", "sdG"}], "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"maxMean", ",", "maxSD", ",", "pct"}], "}"}], ",", 
              RowBox[{
               RowBox[{"maxMean", "=", 
                RowBox[{"maxYFromPlot", "[", "meanG", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"maxSD", "=", 
                RowBox[{"maxYFromPlot", "[", "sdG", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"pct", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"maxMean", "==", "0"}], ",", 
                  RowBox[{"Missing", "[", "\"\<Undefined\>\"", "]"}], ",", 
                  RowBox[{"100", " ", 
                   RowBox[{"maxSD", "/", "maxMean"}]}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"shape", ",", "maxSD", ",", "maxMean", ",", "pct"}], 
                "}"}]}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"shapes", ",", "meanPlots", ",", "sdPlots"}], "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"rows", "/.", " ", 
             RowBox[{
              RowBox[{"{", 
