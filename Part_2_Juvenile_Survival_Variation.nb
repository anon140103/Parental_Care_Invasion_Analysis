          RowBox[{"{", "}"}], ",", 
          RowBox[{
           RowBox[{"roots", "=", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{
              RowBox[{"First", "@", "roots"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"#1", "-", "#2"}], "]"}], "<", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "6"}]}]}], "&"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Sort", "@", 
            RowBox[{"Select", "[", 
             RowBox[{"roots", ",", 
              RowBox[{
               RowBox[{"#", ">", "tol"}], "&"}]}], "]"}]}]}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
