         RowBox[{"c0", "=", "0.3"}], ",", 
         RowBox[{"sigmaJMax", "=", "1"}], ",", "L", ",", "L0", ",", "Lnorm"}],
         "}"}], ",", 
       RowBox[{
        RowBox[{"mu0", "=", 
         RowBox[{"muStar", "[", "params", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"r0", "=", 
