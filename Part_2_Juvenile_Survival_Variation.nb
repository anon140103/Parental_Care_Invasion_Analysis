Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Collect", " ", "all", " ", "mean", " ", "curves"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"allMeanCurvesSJSat", "=", 
     RowBox[{"{", 
      RowBox[{
      "meanFitnessByCareSJA10Sat", ",", "meanFitnessByCareSJA50Sat", ",", 
       "meanFitnessByCareSJA100Sat", ",", "meanFitnessByCareSJB10Sat", ",", 
       "meanFitnessByCareSJB50Sat", ",", "meanFitnessByCareSJB100Sat", ",", 
       "meanFitnessByCareSJC10Sat", ",", "meanFitnessByCareSJC50Sat", ",", 
       "meanFitnessByCareSJC100Sat"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Collect", " ", "all", " ", "SD", " ", "curves"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allSDCurvesSJSat", "=", 
     RowBox[{"{", 
      RowBox[{
      "sdFitnessByCareSJA10Sat", ",", "sdFitnessByCareSJA50Sat", ",", 
       "sdFitnessByCareSJA100Sat", ",", "sdFitnessByCareSJB10Sat", ",", 
       "sdFitnessByCareSJB50Sat", ",", "sdFitnessByCareSJB100Sat", ",", 
       "sdFitnessByCareSJC10Sat", ",", "sdFitnessByCareSJC50Sat", ",", 
       "sdFitnessByCareSJC100Sat"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"careValuesSJSat", "=", 
     RowBox[{
      RowBox[{"allMeanCurvesSJSat", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "overall", " ", "mean", " ", "of", " ", "means"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"overallMeanSJSat", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"careValuesSJSat", ",", 
        RowBox[{"Mean", "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"allMeanCurvesSJSat", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "]"}]}]}], 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "overall", " ", "mean", " ", "of", " ", "SDs"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"overallSDSJSat", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"careValuesSJSat", ",", 
        RowBox[{"Mean", "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"allSDCurvesSJSat", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "]"}]}]}], 
       "}"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "overall", " ", "mean"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotOverallMeanSJSat", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"overallMeanSJSat", ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Orange", ",", "Thick"}], "]"}]}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<c\>\"", ",", "\"\<Mean \[Lambda]\>\""}], "}"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "overall", " ", "SD"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotOverallSDSJSat", "=", 
