Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Collect", " ", "all", " ", "mean", " ", "curves"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"allMeanCurvesSJSig", "=", 
     RowBox[{"{", 
      RowBox[{
      "meanFitnessByCareSJA10Sig", ",", "meanFitnessByCareSJA50Sig", ",", 
       "meanFitnessByCareSJA100Sig", ",", "meanFitnessByCareSJB10Sig", ",", 
       "meanFitnessByCareSJB50Sig", ",", "meanFitnessByCareSJB100Sig", ",", 
       "meanFitnessByCareSJC10Sig", ",", "meanFitnessByCareSJC50Sig", ",", 
       "meanFitnessByCareSJC100Sig"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Collect", " ", "all", " ", "SD", " ", "curves"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"allSDCurvesSJSig", "=", 
     RowBox[{"{", 
      RowBox[{
      "sdFitnessByCareSJA10Sig", ",", "sdFitnessByCareSJA50Sig", ",", 
       "sdFitnessByCareSJA100Sig", ",", "sdFitnessByCareSJB10Sig", ",", 
       "sdFitnessByCareSJB50Sig", ",", "sdFitnessByCareSJB100Sig", ",", 
       "sdFitnessByCareSJC10Sig", ",", "sdFitnessByCareSJC50Sig", ",", 
       "sdFitnessByCareSJC100Sig"}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"careValuesSJSig", "=", 
     RowBox[{
      RowBox[{"allMeanCurvesSJSig", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "overall", " ", "mean", " ", "of", " ", "means"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"overallMeanSJSig", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"careValuesSJSig", ",", 
        RowBox[{"Mean", "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"allMeanCurvesSJSig", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "]"}]}]}], 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "overall", " ", "mean", " ", "of", " ", "SDs"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"overallSDSJSig", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"careValuesSJSig", ",", 
        RowBox[{"Mean", "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"allSDCurvesSJSig", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "]"}]}]}], 
       "}"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "overall", " ", "mean"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotOverallMeanSJSig", "=", 
