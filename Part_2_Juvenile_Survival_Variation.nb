       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Nu]0"}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Theta]"}], ")"}]}], "]"}]}]}], ")"}], "/.", 
      " ", "params"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sigmaJStar", "[", "params_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Sigma]J0"}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Theta]"}], ")"}]}], "]"}]}]}], ")"}], "/.", 
      " ", "params"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Exponential", " ", "trade"}], "-", "off"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"tradeOff", "[", "\"\<Exp\>\"", "]"}], "[", 
      RowBox[{"params_", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mu0", ",", "r0", ",", "nu0b", ",", "sigmaJ0b"}], "}"}], ",", 
       
       RowBox[{
        RowBox[{"mu0", "=", 
         RowBox[{"muStar", "[", "params", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"r0", "=", 
         RowBox[{"rStar", "[", "params", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"nu0b", "=", 
         RowBox[{"nuStar", "[", "params", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sigmaJ0b", "=", 
         RowBox[{"sigmaJStar", "[", "params", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"mu0", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "a"}], "*", "c"}], "]"}]}], ",", 
           RowBox[{"r0", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{"-", "c"}], "]"}]}], ",", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "nu0b"}], ")"}], "*", 
             RowBox[{"Exp", "[", 
              RowBox[{"-", "c"}], "]"}]}]}], ",", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "sigmaJ0b"}], ")"}], "*", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "a"}], "*", "c"}], "]"}]}]}]}], "}"}], "/.", " ", 
         "params"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Saturating", " ", "trade"}], "-", "off"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"tradeOff", "[", "\"\<Saturating\>\"", "]"}], "[", 
      RowBox[{"params_", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mu0", ",", "r0", ",", "nu0b", ",", "sigmaJ0b", ",", 
         RowBox[{"V", "=", "0.9"}], ",", 
         RowBox[{"Khalf", "=", "0.3"}], ",", 
         RowBox[{"sigmaJMax", "=", "0.9"}], ",", 
         RowBox[{"costR", "=", "0.8"}], ",", 
         RowBox[{"costNu", "=", "0.8"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"mu0", "=", 
         RowBox[{"muStar", "[", "params", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"r0", "=", 
         RowBox[{"rStar", "[", "params", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"nu0b", "=", 
         RowBox[{"nuStar", "[", "params", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sigmaJ0b", "=", 
         RowBox[{"sigmaJStar", "[", "params", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"mu0", "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"V", "*", "c"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"Khalf", "+", "c"}], ")"}]}]}], ")"}]}], ",", 
           RowBox[{"r0", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "costR"}], "*", "c"}], "]"}]}], ",", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "nu0b"}], ")"}], "*", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "costNu"}], "*", "c"}], "]"}]}]}], ",", 
           RowBox[{"sigmaJ0b", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"sigmaJMax", "-", "sigmaJ0b"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"c", "/", 
               RowBox[{"(", 
                RowBox[{"Khalf", "+", "c"}], ")"}]}], ")"}]}]}]}], "}"}], "/.",
          " ", "params"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Sigmoid", " ", "trade"}], "-", "off"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"tradeOff", "[", "\"\<Sigmoid\>\"", "]"}], "[", 
