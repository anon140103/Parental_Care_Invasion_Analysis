Cell[CellGroupData[{

Cell["Metrics for Stochastic vs Deterministic mean", "Subtitle",
 CellChangeTimes->{{3.980833179562196*^9, 3.9808331962006207`*^9}, {
  3.984458614301347*^9, 3.984458615354281*^9}, {3.984458660636303*^9, 
  3.984458676899365*^9}, {3.986449835368891*^9, 
  3.986449837456029*^9}},ExpressionUUID->"19934091-5c32-4b04-9298-\
63bceb90868c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getLineData", "[", "g_", "]"}], ":=", 
     RowBox[{"First", "@", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Normal", "[", "g", "]"}], ",", 
        RowBox[{
         RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", "Infinity"}],
        "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"maxPointFromData", "[", "data_", "]"}], ":=", 
     RowBox[{"First", "@", 
      RowBox[{"MaximalBy", "[", 
       RowBox[{"data", ",", "Last"}], "]"}]}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"zeroCrossingsXNotOriginAll", "[", 
      RowBox[{"data_", ",", 
       RowBox[{"tol_", ":", 
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pts", "=", 
          RowBox[{"SortBy", "[", 
           RowBox[{"data", ",", "First"}], "]"}]}], ",", "segs", ",", 
         "roots"}], "}"}], ",", 
       RowBox[{
        RowBox[{"segs", "=", 
         RowBox[{"Partition", "[", 
          RowBox[{"pts", ",", "2", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"roots", "=", 
         RowBox[{
          RowBox[{"Reap", "[", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"x1", "=", 
                  RowBox[{"seg", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
                 RowBox[{"y1", "=", 
                  RowBox[{"seg", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
                 RowBox[{"x2", "=", 
                  RowBox[{"seg", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", 
                 RowBox[{"y2", "=", 
                  RowBox[{"seg", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", "y1", "]"}], "<=", "tol"}], "&&", 
                   RowBox[{
                    RowBox[{"Abs", "[", "x1", "]"}], ">", "tol"}]}], ",", 
                  RowBox[{"Sow", "[", "x1", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", "y2", "]"}], "<=", "tol"}], "&&", 
                   RowBox[{
                    RowBox[{"Abs", "[", "x2", "]"}], ">", "tol"}]}], ",", 
                  RowBox[{"Sow", "[", "x2", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"y1", "*", "y2"}], "<", "0"}], ",", 
                  RowBox[{"With", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x0", "=", 
                    RowBox[{"x1", "-", 
                    RowBox[{"y1", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"x2", "-", "x1"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"y2", "-", "y1"}], ")"}]}]}]}]}], "}"}], ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "x0", "]"}], ">", "tol"}], ",", 
                    RowBox[{"Sow", "[", "x0", "]"}]}], "]"}]}], "]"}]}], 
                 "]"}], ";"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"seg", ",", "segs"}], "}"}]}], "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
