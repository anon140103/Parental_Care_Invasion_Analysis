Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extractXY", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "d", "}"}], ",", 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "g", "]"}], ",", 
          RowBox[{
           RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", 
          "Infinity"}], "]"}]}], ";", 
       RowBox[{"First", "[", "d", "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"maxYFromPlot", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xy", "=", 
        RowBox[{"extractXY", "[", "g", "]"}]}], "}"}], ",", 
      RowBox[{"Max", "[", 
       RowBox[{"xy", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fmt4", "[", "x_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"NumericQ", "[", "x", "]"}], ",", 
      RowBox[{"NumberForm", "[", 
