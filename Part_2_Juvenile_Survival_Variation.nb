              RowBox[{"{", 
               RowBox[{"s", ",", 
                RowBox[{"fmt4", "[", "sd", "]"}], ",", 
                RowBox[{"fmt4", "[", "mn", "]"}], ",", 
                RowBox[{"fmt4", "[", "pc", "]"}]}], "}"}]}]}], ")"}], ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Trade-off shape\>\"", 
             ",", "\"\<Max SD(\[Lambda])\>\"", 
             ",", "\"\<Max Mean \[Lambda]\>\"", 
             ",", "\"\<Max SD as % of Max Mean\>\""}], "}"}]}], "]"}], ",", 
         RowBox[{"Frame", "->", "All"}], ",", 
         RowBox[{"Alignment", "->", "Center"}], ",", 
         RowBox[{"Background", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Lighter", "[", 
               RowBox[{"Gray", ",", "0.95"}], "]"}], ",", 
              RowBox[{"{", "White", "}"}]}], "}"}]}], "}"}]}]}], "]"}]}]}], 
