Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Collect", " ", "all", " ", "mean", " ", "curves"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"allMeanCurvesSJExp", "=", 
     RowBox[{"{", 
      RowBox[{
      "meanFitnessByCareSJA10Exp", ",", "meanFitnessByCareSJA50Exp", ",", 
       "meanFitnessByCareSJA100Exp", ",", "meanFitnessByCareSJB10Exp", ",", 
       "meanFitnessByCareSJB50Exp", ",", "meanFitnessByCareSJB100Exp", ",", 
       "meanFitnessByCareSJC10Exp", ",", "meanFitnessByCareSJC50Exp", ",", 
       "meanFitnessByCareSJC100Exp"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Collect", " ", "all", " ", "SD", " ", "curves"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"allSDCurvesSJExp", "=", 
     RowBox[{"{", 
      RowBox[{
      "sdFitnessByCareSJA10Exp", ",", "sdFitnessByCareSJA50Exp", ",", 
       "sdFitnessByCareSJA100Exp", ",", "sdFitnessByCareSJB10Exp", ",", 
       "sdFitnessByCareSJB50Exp", ",", "sdFitnessByCareSJB100Exp", ",", 
       "sdFitnessByCareSJC10Exp", ",", "sdFitnessByCareSJC50Exp", ",", 
       "sdFitnessByCareSJC100Exp"}], "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"careValuesSJExp", "=", 
     RowBox[{
      RowBox[{"allMeanCurvesSJExp", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "overall", " ", "mean", " ", "of", " ", "means"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"overallMeanSJExp", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"careValuesSJExp", ",", 
        RowBox[{"Mean", "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"allMeanCurvesSJExp", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "]"}]}]}], 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "overall", " ", "mean", " ", "of", " ", "SDs"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"overallSDSJExp", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"careValuesSJExp", ",", 
        RowBox[{"Mean", "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"allSDCurvesSJExp", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "]"}]}]}], 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "overall", " ", "mean"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"plotOverallMeanSJExp", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"overallMeanSJExp", ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Orange", ",", "Thick"}], "]"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<c\>\"", ",", "\"\<Mean \[Lambda]\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", 
        RowBox[{"{", 
         RowBox[{"450", ",", "276"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "overall", " ", "SD"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotOverallSDSJExp", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"overallSDSJExp", ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"0", ",", "0.35", ",", "0"}], "]"}], ",", "Thick"}], 
         "]"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<c\>\"", ",", "\"\<Mean SD(\[Lambda])\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", 
        RowBox[{"{", 
         RowBox[{"450", ",", "276"}], "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]",
    "plotOverallMeanSJExp", "\n", "plotOverallSDSJExp", "\n", 
   "\n"}]}]], "Input",
